@implements IDisposable
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using MudBlazorCrmApp.Shared.Blazor.Services.Agent
@inject AgentClientService Agent
@inject AppText L
@inject IJSRuntime JS
@inject NavigationManager Nav

<div data-agent-enabled="@_enabled" data-agent-open="@Agent.IsDrawerOpen">
@if (_enabled && Agent.IsRunning && !Agent.WaitingForPermission && !Agent.WaitingForUserAnswer)
{
    <div class="agent-glow" aria-hidden="true"></div>
}
@if (_enabled && Agent.IsDrawerOpen)
{
    var isEmptyCenter = Agent.Entries.Count == 0 && !Agent.IsRunning && !_showHistory && !Agent.WaitingForPermission && !Agent.WaitingForUserAnswer;
    var views = AgentLogViewBuilder.Build(Agent.Entries, L);
    var workingGroup = Agent.IsRunning && !Agent.WaitingForPermission && !Agent.WaitingForUserAnswer
        && views.Count > 0 && views[^1] is AgentStepGroupView;
    var workMode = AgentLogViewBuilder.CurrentMode(Agent.Entries, Agent.WaitingForUserAnswer || Agent.WaitingForPermission);
    <MudPaper Class="agent-floating-panel agent-panel__body"
              data-agent-panel="true"
              data-drop-label="@L["AGENT_DROP_FILES"]"
              data-testid="agent-panel">
        <div class="agent-resize-handle agent-resize-n" data-resize-dir="n"></div>
        <div class="agent-resize-handle agent-resize-s" data-resize-dir="s"></div>
        <div class="agent-resize-handle agent-resize-e" data-resize-dir="e"></div>
        <div class="agent-resize-handle agent-resize-w" data-resize-dir="w"></div>
        <div class="agent-resize-handle agent-resize-nw" data-resize-dir="nw"></div>
        <div class="agent-resize-handle agent-resize-ne" data-resize-dir="ne"></div>
        <div class="agent-resize-handle agent-resize-sw" data-resize-dir="sw"></div>
        <div class="agent-resize-handle agent-resize-se" data-resize-dir="se"></div>
        <ErrorBoundary>
            <ChildContent>
                <div class="agent-panel__header" data-testid="agent-drag-handle" title="@L["AGENT_PANEL_HEADER_HINT"]">
                    <span class="agent-panel__title">@(_showHistory ? L["AGENT_CHATS"] : L["AGENT_TITLE"])</span>
                    <div class="agent-panel__header-buttons">
                        <button type="button" class="agent-button" disabled="@Agent.IsRunning"
                                @onclick="NewChat" title="@L["AGENT_NEW_CHAT"]" data-testid="agent-new-chat">
                            @L["AGENT_NEW_CHAT"]
                        </button>
                        <button type="button" class="agent-button agent-button--outline"
                                @onclick="ToggleHistory" data-testid="agent-history-btn">
                            @if (_showHistory)
                            {
                                @L["AGENT_BACK"]
                            }
                            else
                            {
                                @($"{L["AGENT_CHATS"]} ({Agent.SavedChats.Count})")
                            }
                        </button>
                        <button type="button" class="agent-button agent-button--outline"
                                @onclick="ClosePanel" title="@L["AGENT_CLOSE"]" data-testid="agent-close-btn">
                            @L["AGENT_CLOSE"]
                        </button>
                    </div>
                </div>

                @if (_showHistory)
                {
                    <div class="agent-panel__log" data-testid="agent-history-list">
                        @if (Agent.SavedChats.Count == 0)
                        {
                            <div class="agent-panel__empty">@L["AGENT_NO_HISTORY"]</div>
                        }
                        else
                        {
                            @foreach (var chat in Agent.SavedChats)
                            {
                                var stateClass = (chat.ChatKey == Agent.CurrentChatKey ? "agent-session--current" : "") + (Agent.IsRunning ? " agent-session--busy" : "");
                                <div class="agent-session @stateClass"
                                     title="@L["AGENT_OPEN_THIS_CHAT"]" @onclick="@(() => SelectChat(chat.ChatKey))">
                                    <span class="agent-session__title">@(string.IsNullOrWhiteSpace(chat.Title) ? chat.ChatKey : chat.Title)</span>
                                    <span class="agent-session__when">@chat.UpdatedDate.ToString("yyyy/MM/dd HH:mm")</span>
                                    <span @onclick:stopPropagation="true">
                                        <button type="button" class="agent-button agent-button--outline"
                                                @onclick="@(() => Agent.DeleteChatAsync(chat.ChatKey))" title="@L["ACTION_DELETE"]">
                                            @L["ACTION_DELETE"]
                                        </button>
                                    </span>
                                </div>
                            }
                        }
                    </div>
                }
                else if (isEmptyCenter)
                {
                    <div class="agent-panel__welcome">
                        <div class="agent-panel__welcome-title">@_greeting</div>
                        <AgentComposer Value="@_taskInput" Centered="true"
                                       AttachmentsEnabled="Agent.AttachmentsEnabled"
                                       IsRunning="Agent.IsRunning" IsUploading="Agent.IsUploadingAttachment"
                                       Mode="Agent.Mode" HasAlwaysAllowed="Agent.HasAlwaysAllowed"
                                       OnClearAlwaysAllowed="Agent.ClearAlwaysAllowed"
                                       IsListening="_isListening" AttachedFiles="Agent.AttachedFiles"
                                       OnInput="OnInputTask"
                                       OnKeyDown="OnTaskKeyDown"
                                       OnFilesSelected="OnAttachmentSelected"
                                       RemoveAttachment="@(id => Agent.RemoveAttachmentAsync(id))"
                                       Send="SendTask" Stop="Agent.Stop" ToggleVoice="ToggleVoiceWrapper"
                                       OnModeChanged="OnModeChanged" />
                        <div class="agent-panel__row agent-panel__row--options">
                            <button type="button" class="agent-button agent-button--option"
                                    @onclick="@(() => Agent.SendTaskAsync(L["AGENT_CHIP_CUSTOMERS_PROMPT"]))">@L["AGENT_CHIP_CUSTOMERS_LABEL"]</button>
                            <button type="button" class="agent-button agent-button--option"
                                    @onclick="@(() => Agent.SendTaskAsync(L["AGENT_CHIP_SALES_PROMPT"]))">@L["AGENT_CHIP_SALES_LABEL"]</button>
                            <button type="button" class="agent-button agent-button--option"
                                    @onclick="@(() => Agent.SendTaskAsync(L["AGENT_CHIP_GUIDE_PROMPT"]))">@L["AGENT_CHIP_GUIDE_LABEL"]</button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="agent-panel__log">
                        @if (views.Count == 0)
                        {
                            <div class="agent-panel__empty">@L["AGENT_EMPTY_STATE"]</div>
                        }
                        <AgentLogList @ref="_logList" Views="views" WorkingGroup="workingGroup"
                                      WorkMode="workMode" IsRunning="Agent.IsRunning" />

                        @if (Agent.LastLedger.Count > 0 || Agent.OpenedLedger.Count > 0)
                        {
                            <details class="agent-notes" data-testid="agent-ledger">
                                <summary>@L["AGENT_ACTIONS_DONE"] (@(Agent.LastLedger.Count + Agent.OpenedLedger.Count))</summary>
                                <ul data-testid="agent-ledger-wrote" style="margin:4px 0;padding-inline-start:22px;">
                                    @foreach (var item in Agent.LastLedger)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                                <ul data-testid="agent-ledger-opened" style="margin:4px 0;padding-inline-start:22px;">
                                    @foreach (var item in Agent.OpenedLedger)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </details>
                        }

                        @if (Agent.TotalCalls > 0)
                        {
                            <div class="agent-stats" data-testid="agent-stats"
                                 title="@(Agent.LastStepTimings.Count > 0 ? string.Join(" · ", Agent.LastStepTimings) : null)">
                                @string.Format(L["AGENT_STATS_FORMAT"], Agent.TotalCalls, Agent.TotalInputTokens, Agent.TotalOutputTokens)
                                @if (Agent.ShowCost)
                                {
                                    @string.Format(L["AGENT_STATS_COST_FORMAT"], Agent.TotalCost)
                                }
                            </div>
                        }

                        <div class="agent-panel__copy-row">
                            <button type="button" class="agent-copy agent-copy--labelled @(_copiedChat ? "agent-copy--copied" : "")"
                                    @onclick="CopyChat" data-testid="agent-copy-chat-btn">
                                @if (_copiedChat)
                                {
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                                }
                                else
                                {
                                    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.5" stroke="currentColor" stroke-width="1.4" /></svg>
                                }
                                <span>@(_copiedChat ? L["AGENT_COPIED"] : L["AGENT_COPY_CHAT"])</span>
                            </button>
                        </div>
                    </div>
                }

                @if (!isEmptyCenter)
                {
                    <div class="agent-panel__footer">
                        @if (Agent.WaitingForPermission)
                        {
                            <div data-testid="agent-question">
                                <div class="agent-card agent-card--ask" data-testid="agent-question-text">
                                    @string.Format(L["AGENT_PERM_PROMPT"], Agent.PendingPermissionLabel, Agent.PendingPermissionRisk)
                                </div>
                                <div class="agent-panel__row agent-panel__row--options">
                                    <button type="button" class="agent-button agent-button--option"
                                            data-testid="agent-question-option"
                                            @onclick="@(() => Agent.ResolvePermission(PermissionDecision.AllowOnce))">
                                        @L["AGENT_PERM_ALLOW_ONCE"]
                                    </button>
                                    @if (Agent.PendingPermissionRisk is "light" or "export")
                                    {
                                        <button type="button" class="agent-button agent-button--outline agent-button--option"
                                                data-testid="agent-question-option"
                                                @onclick="@(() => Agent.ResolvePermission(PermissionDecision.AllowAlways))">
                                            @L["AGENT_PERM_ALLOW_ALWAYS"]
                                        </button>
                                    }
                                    <button type="button" class="agent-button agent-button--outline agent-button--option"
                                            data-testid="agent-question-option"
                                            @onclick="@(() => Agent.ResolvePermission(PermissionDecision.Deny))">
                                        @L["AGENT_PERM_DENY"]
                                    </button>
                                    <button type="button" class="agent-button agent-button--outline"
                                            @onclick="@(() => Agent.Stop())" title="@L["AGENT_STOP"]" data-testid="agent-stop">
                                        @L["AGENT_STOP"]
                                    </button>
                                </div>
                                <AgentModePicker Value="Agent.Mode" OnValueChanged="OnModeChanged"
                                                 HasAlwaysAllowed="Agent.HasAlwaysAllowed"
                                                 OnClearAlwaysAllowed="Agent.ClearAlwaysAllowed" />
                            </div>
                        }
                        else if (Agent.WaitingForUserAnswer)
                        {
                            <div data-testid="agent-question">
                                @if (!string.IsNullOrWhiteSpace(Agent.PendingQuestion))
                                {
                                    <div class="agent-pre-line" data-testid="agent-question-text" style="margin-bottom:6px;">@Agent.PendingQuestion</div>
                                }
                                @if (Agent.PendingQuestionOptions is { Length: > 0 } opts)
                                {
                                    <div class="agent-panel__row agent-panel__row--options">
                                        @foreach (var opt in opts)
                                        {
                                            <button type="button" class="agent-button agent-button--option"
                                                    @onclick="@(() => PickUserOption(opt))" data-testid="agent-question-option">@opt</button>
                                        }
                                    </div>
                                }
                                <div class="agent-panel__row">
                                    <input class="agent-panel__input" style="flex:1;"
                                           placeholder="@((Agent.PendingQuestionOptions is { Length: > 0 }) ? L["AGENT_OTHER_ANSWER"] : L["AGENT_YOUR_ANSWER"])"
                                           @bind="_answerInput" @bind:event="oninput" @onkeydown="OnAnswerKeyDown"
                                           data-testid="agent-question-other-input" />
                                    <button type="button" class="agent-button" @onclick="SubmitAnswer"
                                            data-testid="agent-question-other-send">@L["AGENT_SEND"]</button>
                                    <button type="button" class="agent-button agent-button--outline"
                                            @onclick="@(() => Agent.Stop())" title="@L["AGENT_STOP"]" data-testid="agent-stop">
                                        @L["AGENT_STOP"]
                                    </button>
                                </div>
                                <AgentModePicker Value="Agent.Mode" OnValueChanged="OnModeChanged"
                                                 HasAlwaysAllowed="Agent.HasAlwaysAllowed"
                                                 OnClearAlwaysAllowed="Agent.ClearAlwaysAllowed" />
                            </div>
                        }
                        else
                        {
                            <AgentComposer Value="@_taskInput" Centered="false"
                                           AttachmentsEnabled="Agent.AttachmentsEnabled"
                                           IsRunning="Agent.IsRunning" IsUploading="Agent.IsUploadingAttachment"
                                           Mode="Agent.Mode" HasAlwaysAllowed="Agent.HasAlwaysAllowed"
                                           OnClearAlwaysAllowed="Agent.ClearAlwaysAllowed"
                                           IsListening="_isListening" AttachedFiles="Agent.AttachedFiles"
                                           OnInput="OnInputTask"
                                           OnKeyDown="OnTaskKeyDown"
                                           OnFilesSelected="OnAttachmentSelected"
                                           RemoveAttachment="@(id => Agent.RemoveAttachmentAsync(id))"
                                           Send="SendTask" Stop="Agent.Stop" ToggleVoice="ToggleVoiceWrapper"
                                           OnModeChanged="OnModeChanged" />
                        }
                    </div>
                }
            </ChildContent>
            <ErrorContent Context="ex">
                <MudAlert Severity="Severity.Error" Class="ma-3">
                    @L["AGENT_ERROR_PREFIX"]@ex.Message
                </MudAlert>
            </ErrorContent>
        </ErrorBoundary>
    </MudPaper>
}
</div>

@code {
    private bool _enabled;
    private bool _showHistory;
    private bool _isListening;
    private string _taskInput = string.Empty;
    private string _answerInput = string.Empty;
    private string _greeting = string.Empty;
    private int _lastGreetingIdx = -1;
    private const int MaxFilesPerPick = 5;
    private DotNetObjectReference<AgentPanel>? _dotNetRef;
    private bool _copiedChat;
    private bool _hydratedFromStorage;
    private bool _suppressSave;
    private bool _disposed;
    private CancellationTokenSource? _stateSaveCts;
    private AgentLogList? _logList;
    private const int GreetingCount = 10;
    private const int CopiedChatFeedbackMs = 1200;

    private string PickGreeting()
    {
        var idx = Random.Shared.Next(1, GreetingCount + 1);
        if (idx == _lastGreetingIdx) idx = idx % GreetingCount + 1;
        _lastGreetingIdx = idx;
        return L[$"AGENT_GREETING_{idx}"];
    }

    private void OnInputTask(string value) => _taskInput = value;

    private async Task NewChat()
    {
        if (Agent.IsRunning) return;
        _showHistory = false;
        _greeting = PickGreeting();
        _logList?.ResetOpenGroups();
        await Agent.NewChatAsync();
    }

    private async Task CopyChat()
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("crmAgentDriver.copyText", AgentLogViewBuilder.ChatText(Agent.Entries, L));
            if (!ok || _disposed) return;
            _copiedChat = true;
            StateHasChanged();
            await Task.Delay(CopiedChatFeedbackMs);
            if (!_disposed) { _copiedChat = false; StateHasChanged(); }
        }
        catch (JSException) { /* clipboard unavailable */ }
    }

    private Task ToggleVoiceWrapper() => ToggleVoiceInput();

    private async Task OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        if (Agent.IsRunning || Agent.IsUploadingAttachment) return;
        try
        {
            foreach (var file in e.GetMultipleFiles(MaxFilesPerPick))
            {
                if (file.Size is 0 or > AgentClientService.MaxAttachmentBytes)
                {
                    Agent.AddAttachmentError(file.Name, file.Size, L["AGENT_FILE_TOO_BIG"]);
                    continue;
                }
                await using var stream = file.OpenReadStream(AgentClientService.MaxAttachmentBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                await Agent.UploadAttachmentAsync(file.Name, ms.ToArray());
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            Agent.AddAttachmentError("file", 0, L["AGENT_FILE_READ_ERR"]);
        }
    }

    private async Task ToggleVoiceInput()
    {
        if (_isListening)
        {
            _isListening = false;
            try { await JS.InvokeAsync<string>("crmAgentDriver.stopVoiceInput"); }
            catch (JSException) { /* ignore */ }
            return;
        }
        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            var res = await JS.InvokeAsync<string>("crmAgentDriver.startVoiceInput", _dotNetRef);
            if (res.Contains("\"started\":true", StringComparison.Ordinal))
                _isListening = true;
        }
        catch (JSException) { _isListening = false; }
    }

    [JSInvokable]
    public void OnVoiceResult(string transcript)
    {
        if (!string.IsNullOrWhiteSpace(transcript))
            _taskInput = string.IsNullOrWhiteSpace(_taskInput) ? transcript.Trim() : $"{_taskInput.Trim()} {transcript.Trim()}";
        _isListening = false;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnVoiceError(string error)
    {
        _isListening = false;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnVoiceEnded()
    {
        _isListening = false;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnFileDropped(string fileName, string base64)
    {
        if (!Agent.AttachmentsEnabled || Agent.IsRunning || Agent.IsUploadingAttachment) return;
        try
        {
            var bytes = Convert.FromBase64String(base64);
            await Agent.UploadAttachmentAsync(fileName, bytes);
        }
        catch (FormatException)
        {
            Agent.AddAttachmentError(fileName, 0, L["AGENT_FILE_READ_ERR"]);
        }
    }

    [JSInvokable]
    public void OnFileDropError(string fileName, long size) =>
        Agent.AddAttachmentError(fileName, size, L["AGENT_FILE_TOO_BIG"]);

    private void PickUserOption(string option)
    {
        _answerInput = string.Empty;
        Agent.SubmitUserAnswer(option);
    }

    protected override async Task OnInitializedAsync()
    {
        _greeting = PickGreeting();
        Agent.OnStateChanged += HandleStateChanged;
        Agent.OnLogoutCleared += HandleLogoutCleared;
        _enabled = await Agent.IsEnabledAsync();
        if (_enabled)
        {
            await Agent.LoadChatsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_enabled) return;
        if (firstRender && !_hydratedFromStorage)
        {
            _hydratedFromStorage = true;
            await HydratePanelStateAsync();
        }
        if (Agent.IsDrawerOpen)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("crmAgentDriver.enablePanelDrag");
                await JS.InvokeVoidAsync("crmAgentDriver.bindFileDrop", _dotNetRef);
            }
            catch (JSException) { /* JS not yet ready */ }
        }
    }

    private async Task HydratePanelStateAsync()
    {
        _suppressSave = true;
        try
        {
            var raw = await JS.InvokeAsync<string>("crmAgentDriver.loadPanelState", "crm_agent_panel_state");
            if (string.IsNullOrWhiteSpace(raw)) return;
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            var root = doc.RootElement;
            if (root.TryGetProperty("draft", out var dEl) && dEl.ValueKind == System.Text.Json.JsonValueKind.String)
                _taskInput = dEl.GetString() ?? string.Empty;
            if (root.TryGetProperty("mode", out var mEl) && Enum.TryParse<AgentMode>(mEl.GetString(), out var mode) && Enum.IsDefined(mode))
                Agent.Mode = mode;
            if (root.TryGetProperty("open", out var oEl) && oEl.ValueKind == System.Text.Json.JsonValueKind.True)
                Agent.IsDrawerOpen = true;
            if (!_disposed) StateHasChanged();
        }
        catch (Exception ex) when (ex is JSException or System.Text.Json.JsonException)
        {
            // Ignore corrupt or unavailable localStorage state on initial load
        }
        finally
        {
            _suppressSave = false;
        }
    }

    private void HandleLogoutCleared()
    {
        _stateSaveCts?.Cancel();
        _stateSaveCts?.Dispose();
        _stateSaveCts = null;
        _taskInput = string.Empty;
        _answerInput = string.Empty;
        _showHistory = false;
        _logList?.ResetOpenGroups();
        _greeting = PickGreeting();
    }

    private void SchedulePanelStateSave()
    {
        if (_disposed || _suppressSave || Agent.SuppressStateSave) return;
        _stateSaveCts?.Cancel();
        _stateSaveCts?.Dispose();
        _stateSaveCts = new CancellationTokenSource();
        var token = _stateSaveCts.Token;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(300, token);
                if (_disposed || _suppressSave || Agent.SuppressStateSave) return;
                var json = System.Text.Json.JsonSerializer.Serialize(new
                {
                    open = Agent.IsDrawerOpen,
                    mode = Agent.Mode.ToString(),
                    draft = _taskInput
                });
                await JS.InvokeVoidAsync("crmAgentDriver.savePanelState", "crm_agent_panel_state", json);
            }
            catch (Exception ex) when (ex is OperationCanceledException or JSException)
            {
                // Cancelled by newer state change, logout, or JS runtime unavailable
            }
        });
    }

    private async Task ToggleHistory()
    {
        _showHistory = !_showHistory;
        if (_showHistory)
        {
            await Agent.LoadChatsAsync();
        }
    }

    private async Task SelectChat(string chatKey)
    {
        _showHistory = false;
        // _logList is unmounted while the history list is shown, so this is usually a no-op;
        // the fresh AgentLogList for the loaded chat starts with clean state anyway.
        _logList?.ResetOpenGroups();
        await Agent.LoadChatAsync(chatKey);
    }

    private void HandleStateChanged()
    {
        SchedulePanelStateSave();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SendTask()
    {
        var goal = _taskInput.Trim();
        if (string.IsNullOrEmpty(goal)) return;
        _taskInput = string.Empty;
        await Agent.SendTaskAsync(goal);
    }

    private void SubmitAnswer()
    {
        var ans = _answerInput.Trim();
        if (string.IsNullOrEmpty(ans)) return;
        _answerInput = string.Empty;
        Agent.SubmitUserAnswer(ans);
    }

    private async Task ClosePanel()
    {
        if (_isListening)
        {
            _isListening = false;
            try { await JS.InvokeAsync<string>("crmAgentDriver.stopVoiceInput"); }
            catch (JSException) { /* ignore voice stop errors on close */ }
        }
        Agent.IsDrawerOpen = false;
    }

    private void OnModeChanged(AgentMode mode)
    {
        if (Agent.IsRunning) return;
        if (Enum.IsDefined(mode))
            Agent.Mode = mode;
    }

    private async Task OnTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !Agent.IsRunning && !Agent.IsUploadingAttachment)
        {
            await SendTask();
        }
    }

    private void OnAnswerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            SubmitAnswer();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Agent.OnStateChanged -= HandleStateChanged;
        Agent.OnLogoutCleared -= HandleLogoutCleared;
        _stateSaveCts?.Cancel();
        _stateSaveCts?.Dispose();
        if (_isListening)
        {
            _isListening = false;
            _ = JS.InvokeVoidAsync("crmAgentDriver.stopVoiceInput");
        }
        _dotNetRef?.Dispose();
    }
}
