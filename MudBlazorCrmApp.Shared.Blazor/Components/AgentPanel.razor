@implements IDisposable
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using MudBlazorCrmApp.Shared.Blazor.Services.Agent
@inject AgentClientService Agent
@inject AppText L
@inject IJSRuntime JS
@inject NavigationManager Nav

<div data-agent-enabled="@_enabled" data-agent-open="@Agent.IsDrawerOpen">
@if (_enabled && Agent.IsRunning)
{
    <div class="agent-working-aura" data-testid="agent-working-aura"></div>
}
@if (_enabled && Agent.IsDrawerOpen)
{
    var isEmptyCenter = Agent.Entries.Count == 0 && !Agent.IsRunning && !_showHistory && !Agent.WaitingForPermission && !Agent.WaitingForUserAnswer;
    <MudPaper Elevation="12"
              Class="agent-floating-panel"
              data-agent-panel="true"
              data-testid="agent-panel">
        <div class="agent-resize-handle agent-resize-n" data-resize-dir="n"></div>
        <div class="agent-resize-handle agent-resize-s" data-resize-dir="s"></div>
        <div class="agent-resize-handle agent-resize-e" data-resize-dir="e"></div>
        <div class="agent-resize-handle agent-resize-w" data-resize-dir="w"></div>
        <div class="agent-resize-handle agent-resize-nw" data-resize-dir="nw"></div>
        <div class="agent-resize-handle agent-resize-ne" data-resize-dir="ne"></div>
        <div class="agent-resize-handle agent-resize-sw" data-resize-dir="sw"></div>
        <div class="agent-resize-handle agent-resize-se" data-resize-dir="se"></div>
        <ErrorBoundary>
            <ChildContent>
                <MudStack Style="height:100%;" Spacing="0" data-agent-panel="true">
                    <InputFile id="agent-file-input" data-testid="agent-attach-input" OnChange="OnAttachmentSelected" multiple accept=".txt,.md,.json,.log,.csv,.tsv,.xlsx,.png,.jpg,.jpeg,.webp" style="display:none;" />
                    <MudToolBar Dense="true" Class="px-3 agent-drag-handle" data-testid="agent-drag-handle">
                        <div style="width:28px;height:28px;border-radius:8px;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb, var(--mud-palette-primary) 16%, transparent);" class="me-2">
                            <MudIcon Icon="@AgentIcons.CopilotSvg" Color="Color.Primary" Size="Size.Small" />
                        </div>
                        <MudText Typo="Typo.subtitle2"><b>@L["AGENT_TITLE"]</b></MudText>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small" OnClick="ToggleHistory" title="@L["AGENT_HISTORY"]" data-testid="agent-history-btn" />
                        <MudIconButton Icon="@Icons.Material.Filled.AddComment" Size="Size.Small" OnClick="@(async () => { _showHistory = false; await Agent.NewChatAsync(); })" title="@L["AGENT_NEW_CHAT"]" data-testid="agent-new-chat" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="ClosePanel" title="@L["AGENT_CLOSE"]" data-testid="agent-close-btn" />
                    </MudToolBar>

                    @if (_showHistory)
                    {
                        <div style="flex:1;overflow-y:auto;padding:12px;" data-testid="agent-history-list">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["AGENT_HISTORY"]</MudText>
                            @if (Agent.SavedChats.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["AGENT_NO_HISTORY"]</MudText>
                            }
                            else
                            {
                                <MudList T="string" Dense="true">
                                    @foreach (var chat in Agent.SavedChats)
                                    {
                                        <MudListItem OnClick="@(() => SelectChat(chat.ChatKey))">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:280px;">
                                                    @(string.IsNullOrWhiteSpace(chat.Title) ? chat.ChatKey : chat.Title)
                                                </MudText>
                                                <span @onclick:stopPropagation="true">
                                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" OnClick="@(() => Agent.DeleteChatAsync(chat.ChatKey))" title="@L["ACTION_DELETE"]" />
                                                </span>
                                            </MudStack>
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        </div>
                    }
                    else if (isEmptyCenter)
                    {
                        <div style="flex:1;overflow-y:auto;padding:24px;" class="d-flex flex-column justify-center align-center gap-3">
                            <div class="agent-hero-badge">
                                <MudIcon Icon="@AgentIcons.CopilotSvg" Size="Size.Large" Style="color:#fff;" />
                            </div>
                            <MudText Typo="Typo.h6" Align="Align.Center"><b>@L["AGENT_TITLE"]</b></MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Style="max-width:340px;">
                                @L["AGENT_EMPTY_STATE"]
                            </MudText>
                            <div class="d-flex flex-wrap justify-center gap-1 my-1">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Agent.SendTaskAsync(L["AGENT_CHIP_CUSTOMERS_PROMPT"]))">@L["AGENT_CHIP_CUSTOMERS_LABEL"]</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Agent.SendTaskAsync(L["AGENT_CHIP_SALES_PROMPT"]))">@L["AGENT_CHIP_SALES_LABEL"]</MudChip>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Agent.SendTaskAsync(L["AGENT_CHIP_GUIDE_PROMPT"]))">@L["AGENT_CHIP_GUIDE_LABEL"]</MudChip>
                            </div>
                            <div class="agent-composer" style="width:100%;" title="@L["AGENT_DROP_FILES"]">
                                @if (Agent.AttachedFiles.Count > 0)
                                {
                                    <div class="agent-chips">
                                        @foreach (var f in Agent.AttachedFiles)
                                        {
                                            <span class="agent-chip @(f.Error != null ? "agent-chip--failed" : "")" title="@(f.Error ?? f.Kind)" data-testid="agent-attach-chip">
                                                <span class="agent-chip__name">@f.FileName</span>
                                                <button type="button" class="agent-chip__remove" @onclick="@(() => Agent.RemoveAttachmentAsync(f.Id))">×</button>
                                            </span>
                                        }
                                    </div>
                                }
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudTextField @bind-Value="_taskInput"
                                                  Placeholder="@L["AGENT_INPUT_PLACEHOLDER"]"
                                                  Variant="Variant.Text"
                                                  Margin="Margin.Dense"
                                                  Underline="false"
                                                  Disabled="@Agent.IsRunning"
                                                  Immediate="true"
                                                  OnKeyDown="OnTaskKeyDown"
                                                  data-testid="agent-input"
                                                  Style="flex:1;" />
                                    <label for="agent-file-input" title="@L["AGENT_ATTACH_HINT"]" style="cursor:pointer;display:inline-flex;align-items:center;padding:4px;opacity:@((Agent.IsRunning || Agent.IsUploadingAttachment) ? "0.5" : "1");pointer-events:@((Agent.IsRunning || Agent.IsUploadingAttachment) ? "none" : "auto");">
                                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                                    </label>
                                    <MudIconButton Icon="@(_isListening ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)" Color="@(_isListening ? Color.Error : Color.Default)" Size="Size.Small" OnClick="ToggleVoiceInput" Disabled="@Agent.IsRunning" title="@L["AGENT_VOICE_HINT"]" data-testid="agent-voice-btn" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SendTask" Disabled="@(string.IsNullOrWhiteSpace(_taskInput) || Agent.IsUploadingAttachment)" title="@L["AGENT_SEND"]" data-testid="agent-run" Style="border-radius:10px;" />
                                </MudStack>
                                <div class="mt-2 pt-2 d-flex justify-start" style="border-top:1px solid var(--mud-palette-lines-default);">
                                    <select class="agent-mode-select"
                                            value="@Agent.Mode"
                                            @onchange="OnModeChanged"
                                            disabled="@Agent.IsRunning"
                                            style="max-width:190px;font-size:12px;background:transparent;color:inherit;border:1px solid var(--mud-palette-lines-default);border-radius:6px;padding:3px 8px;"
                                            data-testid="agent-mode">
                                        <option value="@AgentMode.Manual">@L["AGENT_MODE_MANUAL"]</option>
                                        <option value="@AgentMode.SemiAuto">@L["AGENT_MODE_SEMIAUTO"]</option>
                                        <option value="@AgentMode.Auto">@L["AGENT_MODE_AUTO"]</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                    <div style="flex:1;overflow-y:auto;padding:12px;" class="d-flex flex-column gap-2">
                        @if (Agent.Entries.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                @L["AGENT_EMPTY_STATE"]
                            </MudAlert>
                        }
                        else
                        {
                            @foreach (var entry in Agent.Entries)
                            {
                                @if (entry.Kind == "user")
                                {
                                    <MudPaper Class="pa-2 px-3 align-self-end agent-bubble-user" Elevation="0">
                                        <MudText Typo="Typo.body2" Style="color:#fff;">@entry.Text</MudText>
                                    </MudPaper>
                                }
                                else if (entry.Kind == "assistant")
                                {
                                    var parsed = AgentWidgetParser.Parse(entry.Text);
                                    <MudPaper Class="pa-3 align-self-start agent-bubble-assistant" Elevation="0" Style="word-break:break-word;position:relative;" data-testid="agent-result">
                                        <div class="d-flex justify-end mb-1">
                                            <MudIconButton Icon="@(_copiedEntry == entry ? Icons.Material.Filled.Check : Icons.Material.Filled.ContentCopy)"
                                                           Size="Size.Small"
                                                           OnClick="@(() => CopyEntry(entry))"
                                                           title="@L[_copiedEntry == entry ? "AGENT_COPIED" : "AGENT_COPY"]"
                                                           data-testid="agent-copy-btn" />
                                        </div>
                                        @if (parsed.Kpis.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-2 mb-2">
                                                @foreach (var kpi in parsed.Kpis)
                                                {
                                                    <div class="agent-widget-kpi">
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@kpi.Title</MudText>
                                                        <MudText Typo="Typo.subtitle2"><b>@kpi.Value</b></MudText>
                                                        @if (!string.IsNullOrWhiteSpace(kpi.Trend))
                                                        {
                                                            <MudText Typo="Typo.caption" Color="Color.Primary">@kpi.Trend</MudText>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        @if (parsed.Charts.Count > 0)
                                        {
                                            <div class="d-flex flex-column gap-2 mb-2" data-testid="agent-widget-charts">
                                                @foreach (var chart in parsed.Charts)
                                                {
                                                    <div class="pa-2 rounded" style="border:1px solid var(--mud-palette-divider);background:var(--mud-palette-background);">
                                                        <MudText Typo="Typo.caption" Class="mb-1"><b>@chart.Title</b></MudText>
                                                        @foreach (var bar in chart.Bars)
                                                        {
                                                            <div class="mb-1">
                                                                <div class="d-flex justify-space-between">
                                                                    <MudText Typo="Typo.caption">@bar.Label</MudText>
                                                                    <MudText Typo="Typo.caption"><b>@bar.Value.ToString("0.##")</b></MudText>
                                                                </div>
                                                                <div style="height:6px;border-radius:3px;background:var(--mud-palette-divider);overflow:hidden;">
                                                                    <div style="@($"height:100%;width:{bar.PercentWidth.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%;background:var(--mud-palette-primary);")"></div>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(parsed.MarkdownText))
                                        {
                                            <div class="mud-typography mud-typography-body2" style="line-height:1.65;">@((MarkupString)SafeMarkdownFormatter.ToSafeHtml(parsed.MarkdownText))</div>
                                        }
                                        @if (parsed.Actions.Count > 0)
                                        {
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @foreach (var act in parsed.Actions)
                                                {
                                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo(act.Route))">@act.Label</MudButton>
                                                }
                                            </div>
                                        }
                                    </MudPaper>
                                }
                                else if (entry.Kind is "help" or "note")
                                {
                                    <details class="agent-help-note" data-testid="agent-help-note">
                                        <summary>@L["AGENT_HELP_NOTE_TITLE"]</summary>
                                        <div class="mt-1 mud-typography mud-typography-caption" style="white-space:pre-wrap;">@entry.Text</div>
                                    </details>
                                }
                                else if (entry.Kind == "tool")
                                {
                                    var displayTool = entry.Text.StartsWith("finish(", StringComparison.Ordinal) ? "finish" : entry.Text;
                                    <div class="agent-tool-pill align-self-end" title="@entry.Text" data-testid="agent-step" data-blocked="@(entry.IsBlocked ? "true" : null)">
                                        <span>⚙</span>
                                        <span style="overflow:hidden;text-overflow:ellipsis;">@displayTool</span>
                                    </div>
                                }
                                else if (entry.Kind == "question")
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                        @entry.Text
                                    </MudAlert>
                                }
                                else if (entry.Kind == "error")
                                {
                                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" data-testid="agent-error">
                                        @L["AGENT_ERROR_PREFIX"]@entry.Text
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Text</MudText>
                                }
                            }
                        }

                        @if (Agent.LastLedger.Count > 0 || Agent.OpenedLedger.Count > 0)
                        {
                            <details class="agent-help-note" data-testid="agent-ledger">
                                <summary>@L["AGENT_ACTIONS_DONE"] (@(Agent.LastLedger.Count + Agent.OpenedLedger.Count))</summary>
                                <ul data-testid="agent-ledger-wrote" class="ps-4 my-1">
                                    @foreach (var item in Agent.LastLedger)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                                <ul data-testid="agent-ledger-opened" class="ps-4 my-1">
                                    @foreach (var item in Agent.OpenedLedger)
                                    {
                                        <li>@item</li>
                                    }
                                </ul>
                            </details>
                        }

                        @if (Agent.IsRunning && !Agent.WaitingForUserAnswer && !Agent.WaitingForPermission)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-1 px-1" data-testid="agent-working">
                                <span class="agent-working__dots"><i></i><i></i><i></i></span>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["AGENT_THINKING"]</MudText>
                            </MudStack>
                        }
                    </div>

                    @if (Agent.TotalCalls > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-3 py-1 border-t" data-testid="agent-stats">
                            @string.Format(L["AGENT_STATS_FORMAT"], Agent.TotalCalls, Agent.TotalInputTokens, Agent.TotalOutputTokens)
                            @if (Agent.ShowCost)
                            {
                                @string.Format(L["AGENT_STATS_COST_FORMAT"], Agent.TotalCost)
                            }
                        </MudText>
                    }
                    }

                    @if (!isEmptyCenter)
                    {
                    <div class="pa-3 border-t">
                        @if (Agent.WaitingForPermission)
                        {
                            <div data-testid="agent-question">
                                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-2" data-testid="agent-question-text">
                                    @string.Format(L["AGENT_PERM_PROMPT"], Agent.PendingPermissionLabel, Agent.PendingPermissionRisk)
                                </MudAlert>
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" data-testid="agent-question-option" OnClick="@(() => Agent.ResolvePermission(PermissionDecision.AllowOnce))">
                                        @L["AGENT_PERM_ALLOW_ONCE"]
                                    </MudButton>
                                    @if (Agent.PendingPermissionRisk is "light" or "export")
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" data-testid="agent-question-option" OnClick="@(() => Agent.ResolvePermission(PermissionDecision.AllowAlways))">
                                            @L["AGENT_PERM_ALLOW_ALWAYS"]
                                        </MudButton>
                                    }
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" data-testid="agent-question-option" OnClick="@(() => Agent.ResolvePermission(PermissionDecision.Deny))">
                                        @L["AGENT_PERM_DENY"]
                                    </MudButton>
                                    <MudIconButton Icon="@Icons.Material.Filled.Stop" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="@(() => Agent.Stop())" title="@L["AGENT_STOP"]" data-testid="agent-stop" Style="border-radius:10px;" />
                                </MudStack>
                            </div>
                        }
                        else if (Agent.WaitingForUserAnswer)
                        {
                            <div data-testid="agent-question">
                                @if (!string.IsNullOrWhiteSpace(Agent.PendingQuestion))
                                {
                                    <MudText Typo="Typo.caption" Class="mb-1 d-block" data-testid="agent-question-text">@Agent.PendingQuestion</MudText>
                                }
                                @if (Agent.PendingQuestionOptions is { Length: > 0 } opts)
                                {
                                    <div class="d-flex flex-wrap gap-1 mb-2">
                                        @foreach (var opt in opts)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => PickUserOption(opt))" data-testid="agent-question-option">@opt</MudButton>
                                        }
                                    </div>
                                }
                                <MudStack Row="true" Spacing="1">
                                    <MudTextField @bind-Value="_answerInput"
                                                  Placeholder="@(Agent.PendingQuestion ?? L["AGENT_INPUT_PLACEHOLDER"])"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true"
                                                  OnKeyDown="OnAnswerKeyDown"
                                                  data-testid="agent-question-other-input"
                                                  Style="flex:1;" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Warning" data-testid="agent-question-other-send" OnClick="SubmitAnswer">@L["AGENT_SEND"]</MudButton>
                                    <MudIconButton Icon="@Icons.Material.Filled.Stop" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="@(() => Agent.Stop())" title="@L["AGENT_STOP"]" data-testid="agent-stop" Style="border-radius:10px;" />
                                </MudStack>
                            </div>
                        }
                        else
                        {
                            <div class="agent-composer" title="@L["AGENT_DROP_FILES"]">
                                @if (Agent.AttachedFiles.Count > 0)
                                {
                                    <div class="agent-chips">
                                        @foreach (var f in Agent.AttachedFiles)
                                        {
                                            <span class="agent-chip @(f.Error != null ? "agent-chip--failed" : "")" title="@(f.Error ?? f.Kind)" data-testid="agent-attach-chip">
                                                <span class="agent-chip__name">@f.FileName</span>
                                                <button type="button" class="agent-chip__remove" @onclick="@(() => Agent.RemoveAttachmentAsync(f.Id))">×</button>
                                            </span>
                                        }
                                    </div>
                                }
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudTextField @bind-Value="_taskInput"
                                                  Placeholder="@L["AGENT_INPUT_PLACEHOLDER"]"
                                                  Variant="Variant.Text"
                                                  Margin="Margin.Dense"
                                                  Underline="false"
                                                  Disabled="@Agent.IsRunning"
                                                  Immediate="true"
                                                  OnKeyDown="OnTaskKeyDown"
                                                  data-testid="agent-input"
                                                  Style="flex:1;" />
                                    @if (Agent.IsRunning)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Stop" Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" OnClick="@(() => Agent.Stop())" title="@L["AGENT_STOP"]" data-testid="agent-stop" Style="border-radius:10px;" />
                                    }
                                    else
                                    {
                                        <label for="agent-file-input" title="@L["AGENT_ATTACH_HINT"]" style="cursor:pointer;display:inline-flex;align-items:center;padding:4px;opacity:@((Agent.IsRunning || Agent.IsUploadingAttachment) ? "0.5" : "1");pointer-events:@((Agent.IsRunning || Agent.IsUploadingAttachment) ? "none" : "auto");">
                                            <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                                        </label>
                                        <MudIconButton Icon="@(_isListening ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)" Color="@(_isListening ? Color.Error : Color.Default)" Size="Size.Small" OnClick="ToggleVoiceInput" Disabled="@Agent.IsRunning" title="@L["AGENT_VOICE_HINT"]" data-testid="agent-voice-btn" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="SendTask" Disabled="@(string.IsNullOrWhiteSpace(_taskInput) || Agent.IsUploadingAttachment)" title="@L["AGENT_SEND"]" data-testid="agent-run" Style="border-radius:10px;" />
                                    }
                                </MudStack>
                                <div class="mt-1 pt-1 d-flex justify-start" style="border-top:1px solid var(--mud-palette-lines-default);">
                                    <select class="agent-mode-select"
                                            value="@Agent.Mode"
                                            @onchange="OnModeChanged"
                                            disabled="@Agent.IsRunning"
                                            style="max-width:190px;font-size:12px;background:transparent;color:inherit;border:1px solid var(--mud-palette-lines-default);border-radius:6px;padding:3px 8px;"
                                            data-testid="agent-mode">
                                        <option value="@AgentMode.Manual">@L["AGENT_MODE_MANUAL"]</option>
                                        <option value="@AgentMode.SemiAuto">@L["AGENT_MODE_SEMIAUTO"]</option>
                                        <option value="@AgentMode.Auto">@L["AGENT_MODE_AUTO"]</option>
                                    </select>
                                </div>
                            </div>
                        }
                    </div>
                    }
                </MudStack>
            </ChildContent>
            <ErrorContent Context="ex">
                <MudAlert Severity="Severity.Error" Class="ma-3">
                    @L["AGENT_ERROR_PREFIX"]@ex.Message
                </MudAlert>
            </ErrorContent>
        </ErrorBoundary>
    </MudPaper>
}
</div>

@code {
    private bool _enabled;
    private bool _showHistory;
    private bool _isListening;
    private string _taskInput = string.Empty;
    private string _answerInput = string.Empty;
    private const int MaxFilesPerPick = 5;
    private DotNetObjectReference<AgentPanel>? _dotNetRef;
    private AgentClientService.AgentChatEntry? _copiedEntry;
    private bool _hydratedFromStorage;
    private bool _suppressSave;
    private bool _disposed;
    private CancellationTokenSource? _stateSaveCts;

    private async Task OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        if (Agent.IsRunning || Agent.IsUploadingAttachment) return;
        try
        {
            foreach (var file in e.GetMultipleFiles(MaxFilesPerPick))
            {
                if (file.Size is 0 or > AgentClientService.MaxAttachmentBytes)
                {
                    Agent.AddAttachmentError(file.Name, file.Size, L["AGENT_FILE_TOO_BIG"]);
                    continue;
                }
                await using var stream = file.OpenReadStream(AgentClientService.MaxAttachmentBytes);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                await Agent.UploadAttachmentAsync(file.Name, ms.ToArray());
            }
        }
        catch (Exception ex) when (ex is IOException or InvalidOperationException)
        {
            Agent.AddAttachmentError("file", 0, L["AGENT_FILE_READ_ERR"]);
        }
    }

    private async Task ToggleVoiceInput()
    {
        if (_isListening)
        {
            _isListening = false;
            try { await JS.InvokeAsync<string>("crmAgentDriver.stopVoiceInput"); }
            catch (JSException) { /* ignore */ }
            return;
        }
        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            var res = await JS.InvokeAsync<string>("crmAgentDriver.startVoiceInput", _dotNetRef);
            if (res.Contains("\"started\":true", StringComparison.Ordinal))
                _isListening = true;
        }
        catch (JSException) { _isListening = false; }
    }

    [JSInvokable]
    public void OnVoiceResult(string transcript)
    {
        if (!string.IsNullOrWhiteSpace(transcript))
            _taskInput = string.IsNullOrWhiteSpace(_taskInput) ? transcript.Trim() : $"{_taskInput.Trim()} {transcript.Trim()}";
        _isListening = false;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnVoiceError(string error)
    {
        _isListening = false;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnVoiceEnded()
    {
        _isListening = false;
        _ = InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnFileDropped(string fileName, string base64)
    {
        if (Agent.IsRunning || Agent.IsUploadingAttachment) return;
        try
        {
            var bytes = Convert.FromBase64String(base64);
            await Agent.UploadAttachmentAsync(fileName, bytes);
        }
        catch (FormatException)
        {
            Agent.AddAttachmentError(fileName, 0, L["AGENT_FILE_READ_ERR"]);
        }
    }

    [JSInvokable]
    public void OnFileDropError(string fileName, long size) =>
        Agent.AddAttachmentError(fileName, size, L["AGENT_FILE_TOO_BIG"]);

    private async Task CopyEntry(AgentClientService.AgentChatEntry entry)
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("crmAgentDriver.copyText", entry.Text);
            if (!ok || _disposed) return;
            _copiedEntry = entry;
            StateHasChanged();
            await Task.Delay(1500);
            if (!_disposed && _copiedEntry == entry) { _copiedEntry = null; StateHasChanged(); }
        }
        catch (JSException) { /* clipboard unavailable */ }
    }

    private void PickUserOption(string option)
    {
        _answerInput = string.Empty;
        Agent.SubmitUserAnswer(option);
    }

    protected override async Task OnInitializedAsync()
    {
        Agent.OnStateChanged += HandleStateChanged;
        Agent.OnLogoutCleared += HandleLogoutCleared;
        _enabled = await Agent.IsEnabledAsync();
        if (_enabled)
        {
            await Agent.LoadChatsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_enabled) return;
        if (firstRender && !_hydratedFromStorage)
        {
            _hydratedFromStorage = true;
            await HydratePanelStateAsync();
        }
        if (Agent.IsDrawerOpen)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("crmAgentDriver.enablePanelDrag");
                await JS.InvokeVoidAsync("crmAgentDriver.bindFileDrop", _dotNetRef);
            }
            catch (JSException) { /* JS not yet ready */ }
        }
    }

    private async Task HydratePanelStateAsync()
    {
        _suppressSave = true;
        try
        {
            var raw = await JS.InvokeAsync<string>("crmAgentDriver.loadPanelState", "crm_agent_panel_state");
            if (string.IsNullOrWhiteSpace(raw)) return;
            using var doc = System.Text.Json.JsonDocument.Parse(raw);
            var root = doc.RootElement;
            if (root.TryGetProperty("draft", out var dEl) && dEl.ValueKind == System.Text.Json.JsonValueKind.String)
                _taskInput = dEl.GetString() ?? string.Empty;
            if (root.TryGetProperty("mode", out var mEl) && Enum.TryParse<AgentMode>(mEl.GetString(), out var mode) && Enum.IsDefined(mode))
                Agent.Mode = mode;
            if (root.TryGetProperty("open", out var oEl) && oEl.ValueKind == System.Text.Json.JsonValueKind.True)
                Agent.IsDrawerOpen = true;
            if (!_disposed) StateHasChanged();
        }
        catch (Exception ex) when (ex is JSException or System.Text.Json.JsonException)
        {
            // Ignore corrupt or unavailable localStorage state on initial load
        }
        finally
        {
            _suppressSave = false;
        }
    }

    private void HandleLogoutCleared()
    {
        _stateSaveCts?.Cancel();
        _stateSaveCts?.Dispose();
        _stateSaveCts = null;
        _taskInput = string.Empty;
        _answerInput = string.Empty;
        _showHistory = false;
        _copiedEntry = null;
    }

    private void SchedulePanelStateSave()
    {
        if (_disposed || _suppressSave || Agent.SuppressStateSave) return;
        _stateSaveCts?.Cancel();
        _stateSaveCts?.Dispose();
        _stateSaveCts = new CancellationTokenSource();
        var token = _stateSaveCts.Token;
        _ = InvokeAsync(async () =>
        {
            try
            {
                await Task.Delay(300, token);
                if (_disposed || _suppressSave || Agent.SuppressStateSave) return;
                var json = System.Text.Json.JsonSerializer.Serialize(new
                {
                    open = Agent.IsDrawerOpen,
                    mode = Agent.Mode.ToString(),
                    draft = _taskInput
                });
                await JS.InvokeVoidAsync("crmAgentDriver.savePanelState", "crm_agent_panel_state", json);
            }
            catch (Exception ex) when (ex is OperationCanceledException or JSException)
            {
                // Cancelled by newer state change, logout, or JS runtime unavailable
            }
        });
    }

    private async Task ToggleHistory()
    {
        _showHistory = !_showHistory;
        if (_showHistory)
        {
            await Agent.LoadChatsAsync();
        }
    }

    private async Task SelectChat(string chatKey)
    {
        _showHistory = false;
        await Agent.LoadChatAsync(chatKey);
    }

    private void HandleStateChanged()
    {
        SchedulePanelStateSave();
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SendTask()
    {
        var goal = _taskInput.Trim();
        if (string.IsNullOrEmpty(goal)) return;
        _taskInput = string.Empty;
        await Agent.SendTaskAsync(goal);
    }

    private void SubmitAnswer()
    {
        var ans = _answerInput.Trim();
        if (string.IsNullOrEmpty(ans)) return;
        _answerInput = string.Empty;
        Agent.SubmitUserAnswer(ans);
    }

    private async Task ClosePanel()
    {
        if (_isListening)
        {
            _isListening = false;
            try { await JS.InvokeAsync<string>("crmAgentDriver.stopVoiceInput"); }
            catch (JSException) { /* ignore voice stop errors on close */ }
        }
        Agent.IsDrawerOpen = false;
    }

    private void OnModeChanged(ChangeEventArgs e)
    {
        if (Agent.IsRunning) return;
        if (Enum.TryParse<AgentMode>(e.Value?.ToString(), out var mode) && Enum.IsDefined(mode))
            Agent.Mode = mode;
    }

    private async Task OnTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !Agent.IsRunning && !Agent.IsUploadingAttachment)
        {
            await SendTask();
        }
    }

    private void OnAnswerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            SubmitAnswer();
        }
    }

    public void Dispose()
    {
        _disposed = true;
        Agent.OnStateChanged -= HandleStateChanged;
        Agent.OnLogoutCleared -= HandleLogoutCleared;
        _stateSaveCts?.Cancel();
        _stateSaveCts?.Dispose();
        if (_isListening)
        {
            _isListening = false;
            _ = JS.InvokeVoidAsync("crmAgentDriver.stopVoiceInput");
        }
        _dotNetRef?.Dispose();
    }
}
