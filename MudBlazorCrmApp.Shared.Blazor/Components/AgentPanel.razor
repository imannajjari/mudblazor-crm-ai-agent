@implements IDisposable
@using Microsoft.JSInterop
@using MudBlazorCrmApp.Shared.Blazor.Services.Agent
@inject AgentClientService Agent
@inject AppText L
@inject IJSRuntime JS

<div data-agent-enabled="@_enabled" data-agent-open="@Agent.IsDrawerOpen">
@if (_enabled && Agent.IsRunning)
{
    <div class="agent-working-aura" data-testid="agent-working-aura"></div>
}
@if (_enabled && Agent.IsDrawerOpen)
{
    var isEmptyCenter = Agent.Entries.Count == 0 && !Agent.IsRunning && !_showHistory && !Agent.WaitingForPermission && !Agent.WaitingForUserAnswer;
    <MudPaper Elevation="12"
              Class="agent-floating-panel"
              data-agent-panel="true"
              data-testid="agent-panel">
        <ErrorBoundary>
            <ChildContent>
                <MudStack Style="height:100%;" Spacing="0" data-agent-panel="true">
                    <MudToolBar Dense="true" Class="px-3 border-b agent-drag-handle" data-testid="agent-drag-handle">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Primary" Class="me-2" />
                        <MudText Typo="Typo.subtitle1"><b>@L["AGENT_TITLE"]</b></MudText>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small" OnClick="ToggleHistory" title="@L["AGENT_HISTORY"]" data-testid="agent-history-btn" />
                        <MudIconButton Icon="@Icons.Material.Filled.AddComment" Size="Size.Small" OnClick="@(async () => { _showHistory = false; await Agent.NewChatAsync(); })" title="@L["AGENT_NEW_CHAT"]" data-testid="agent-new-chat" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => Agent.IsDrawerOpen = false)" title="@L["AGENT_CLOSE"]" data-testid="agent-close-btn" />
                    </MudToolBar>

                    @if (_showHistory)
                    {
                        <div style="flex:1;overflow-y:auto;padding:12px;" data-testid="agent-history-list">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["AGENT_HISTORY"]</MudText>
                            @if (Agent.SavedChats.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@L["AGENT_NO_HISTORY"]</MudText>
                            }
                            else
                            {
                                <MudList T="string" Dense="true">
                                    @foreach (var chat in Agent.SavedChats)
                                    {
                                        <MudListItem OnClick="@(() => SelectChat(chat.ChatKey))">
                                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                                <MudText Typo="Typo.body2" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:280px;">
                                                    @(string.IsNullOrWhiteSpace(chat.Title) ? chat.ChatKey : chat.Title)
                                                </MudText>
                                                <span @onclick:stopPropagation="true">
                                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" OnClick="@(() => Agent.DeleteChatAsync(chat.ChatKey))" Title="@L["ACTION_DELETE"]" />
                                                </span>
                                            </MudStack>
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        </div>
                    }
                    else if (isEmptyCenter)
                    {
                        <div style="flex:1;overflow-y:auto;padding:24px;" class="d-flex flex-column justify-center align-center gap-4">
                            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Primary" Style="font-size:48px;" />
                            <MudText Typo="Typo.h6" Align="Align.Center">@L["AGENT_TITLE"]</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Style="max-width:340px;">
                                @L["AGENT_EMPTY_STATE"]
                            </MudText>
                            <div style="width:100%;">
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudTextField @bind-Value="_taskInput"
                                                  Placeholder="@L["AGENT_INPUT_PLACEHOLDER"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Disabled="@Agent.IsRunning"
                                                  Immediate="true"
                                                  OnKeyDown="OnTaskKeyDown"
                                                  data-testid="agent-input"
                                                  Style="flex:1;" />
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendTask" Disabled="@string.IsNullOrWhiteSpace(_taskInput)" data-testid="agent-send">
                                        @L["AGENT_SEND"]
                                    </MudButton>
                                </MudStack>
                                <div class="mt-2 d-flex justify-start">
                                    <MudSelect T="AgentMode" @bind-Value="Agent.Mode" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:190px;" data-testid="agent-mode">
                                        <MudSelectItem Value="AgentMode.Manual">@L["AGENT_MODE_MANUAL"]</MudSelectItem>
                                        <MudSelectItem Value="AgentMode.SemiAuto">@L["AGENT_MODE_SEMIAUTO"]</MudSelectItem>
                                        <MudSelectItem Value="AgentMode.Auto">@L["AGENT_MODE_AUTO"]</MudSelectItem>
                                    </MudSelect>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                    <div style="flex:1;overflow-y:auto;padding:12px;" class="d-flex flex-column gap-2">
                        @if (Agent.Entries.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                @L["AGENT_EMPTY_STATE"]
                            </MudAlert>
                        }
                        else
                        {
                            @foreach (var entry in Agent.Entries)
                            {
                                @if (entry.Kind == "user")
                                {
                                    <MudPaper Class="pa-2 mud-theme-primary align-self-end" Style="max-width:85%;border-radius:10px;">
                                        <MudText Typo="Typo.body2">@entry.Text</MudText>
                                    </MudPaper>
                                }
                                else if (entry.Kind == "assistant")
                                {
                                    <MudPaper Class="pa-3 align-self-start" Outlined="true" Style="max-width:95%;border-radius:10px;word-break:break-word;">
                                        <div class="mud-typography mud-typography-body2" style="line-height:1.6;">@((MarkupString)SafeMarkdownFormatter.ToSafeHtml(entry.Text))</div>
                                    </MudPaper>
                                }
                                else if (entry.Kind == "tool")
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-family:monospace;direction:ltr;text-align:left;">
                                        ⚙ @entry.Text
                                    </MudText>
                                }
                                else if (entry.Kind == "question")
                                {
                                    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true">
                                        @entry.Text
                                    </MudAlert>
                                }
                                else if (entry.Kind == "error")
                                {
                                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                                        @L["AGENT_ERROR_PREFIX"]@entry.Text
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@entry.Text</MudText>
                                }
                            }
                        }

                        @if (Agent.IsRunning && !Agent.WaitingForUserAnswer && !Agent.WaitingForPermission)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Primary" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@L["AGENT_THINKING"]</MudText>
                            </MudStack>
                        }
                    </div>

                    @if (Agent.TotalCalls > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-3 py-1 border-t" data-testid="agent-stats">
                            @string.Format(L["AGENT_STATS_FORMAT"], Agent.TotalCalls, Agent.TotalInputTokens, Agent.TotalOutputTokens)
                            @if (Agent.ShowCost)
                            {
                                @string.Format(L["AGENT_STATS_COST_FORMAT"], Agent.TotalCost)
                            }
                        </MudText>
                    }
                    }

                    @if (!isEmptyCenter)
                    {
                    <div class="pa-3 border-t">
                        @if (Agent.WaitingForPermission)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="mb-2" data-testid="agent-permission-prompt">
                                @string.Format(L["AGENT_PERM_PROMPT"], Agent.PendingPermissionLabel, Agent.PendingPermissionRisk)
                            </MudAlert>
                            <MudStack Row="true" Spacing="1">
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="@(() => Agent.ResolvePermission(PermissionDecision.AllowOnce))">
                                        @L["AGENT_PERM_ALLOW_ONCE"]
                                    </MudButton>
                                    @if (Agent.PendingPermissionRisk != "destructive")
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" OnClick="@(() => Agent.ResolvePermission(PermissionDecision.AllowAlways))">
                                            @L["AGENT_PERM_ALLOW_ALWAYS"]
                                        </MudButton>
                                    }
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="@(() => Agent.ResolvePermission(PermissionDecision.Deny))">
                                        @L["AGENT_PERM_DENY"]
                                    </MudButton>
                            </MudStack>
                        }
                        else if (Agent.WaitingForUserAnswer)
                        {
                            <MudStack Row="true" Spacing="1">
                                <MudTextField @bind-Value="_answerInput"
                                              Placeholder="@(Agent.PendingQuestion ?? L["AGENT_INPUT_PLACEHOLDER"])"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Immediate="true"
                                              OnKeyDown="OnAnswerKeyDown"
                                              Style="flex:1;" />
                                <MudButton Variant="Variant.Filled" Color="Color.Warning" OnClick="SubmitAnswer">@L["AGENT_SEND"]</MudButton>
                            </MudStack>
                        }
                        else
                        {
                            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                <MudTextField @bind-Value="_taskInput"
                                              Placeholder="@L["AGENT_INPUT_PLACEHOLDER"]"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Disabled="@Agent.IsRunning"
                                              Immediate="true"
                                              OnKeyDown="OnTaskKeyDown"
                                              data-testid="agent-input"
                                              Style="flex:1;" />
                                @if (Agent.IsRunning)
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@(() => Agent.Stop())" data-testid="agent-stop">
                                        @L["AGENT_STOP"]
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendTask" Disabled="@string.IsNullOrWhiteSpace(_taskInput)" data-testid="agent-send">
                                        @L["AGENT_SEND"]
                                    </MudButton>
                                }
                            </MudStack>
                            <div class="mt-2 d-flex justify-start">
                                <MudSelect T="AgentMode" @bind-Value="Agent.Mode" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width:190px;" data-testid="agent-mode">
                                    <MudSelectItem Value="AgentMode.Manual">@L["AGENT_MODE_MANUAL"]</MudSelectItem>
                                    <MudSelectItem Value="AgentMode.SemiAuto">@L["AGENT_MODE_SEMIAUTO"]</MudSelectItem>
                                    <MudSelectItem Value="AgentMode.Auto">@L["AGENT_MODE_AUTO"]</MudSelectItem>
                                </MudSelect>
                            </div>
                        }
                    </div>
                    }
                </MudStack>
            </ChildContent>
            <ErrorContent Context="ex">
                <MudAlert Severity="Severity.Error" Class="ma-3">
                    @L["AGENT_ERROR_PREFIX"]@ex.Message
                </MudAlert>
            </ErrorContent>
        </ErrorBoundary>
    </MudPaper>
}
</div>

@code {
    private bool _enabled;
    private bool _showHistory;
    private string _taskInput = string.Empty;
    private string _answerInput = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        Agent.OnStateChanged += HandleStateChanged;
        _enabled = await Agent.IsEnabledAsync();
        if (_enabled)
        {
            await Agent.LoadChatsAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_enabled && Agent.IsDrawerOpen)
        {
            try { await JS.InvokeVoidAsync("crmAgentDriver.enablePanelDrag"); }
            catch (JSException) { /* JS not yet ready */ }
        }
    }

    private async Task ToggleHistory()
    {
        _showHistory = !_showHistory;
        if (_showHistory)
        {
            await Agent.LoadChatsAsync();
        }
    }

    private async Task SelectChat(string chatKey)
    {
        _showHistory = false;
        await Agent.LoadChatAsync(chatKey);
    }

    private void HandleStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SendTask()
    {
        var goal = _taskInput.Trim();
        if (string.IsNullOrEmpty(goal)) return;
        _taskInput = string.Empty;
        await Agent.SendTaskAsync(goal);
    }

    private void SubmitAnswer()
    {
        var ans = _answerInput.Trim();
        if (string.IsNullOrEmpty(ans)) return;
        _answerInput = string.Empty;
        Agent.SubmitUserAnswer(ans);
    }

    private async Task OnTaskKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey && !Agent.IsRunning)
        {
            await SendTask();
        }
    }

    private void OnAnswerKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            SubmitAnswer();
        }
    }

    public void Dispose()
    {
        Agent.OnStateChanged -= HandleStateChanged;
    }
}
