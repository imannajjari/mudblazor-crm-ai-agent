@implements IDisposable
@using MudBlazorCrmApp.Shared.Blazor.Services.Agent
@inject AppText L
@inject IJSRuntime JS
@inject NavigationManager Nav
@* The agent log list: one row per AgentLogView (task / line / card / notes / folded step run),
   plus the floating working mark when no step group holds it. State local to the log (open step
   groups, copy feedback) lives here; the panel resets it on chat switches. *@

@foreach (var view in Views)
{
    if (view is AgentTaskView task)
    {
        <div class="agent-task @(task.IsFirst ? "agent-task--first" : "")">@($"{L["AGENT_TASK"]}: {task.Entry.Text}")</div>
    }
    else if (view is AgentLineView line && line.Tone == "user")
    {
        <div class="agent-line agent-tone--user">@($"{L["AGENT_YOU"]}: {line.Entry.Text}")</div>
    }
    else if (view is AgentLineView infoLine)
    {
        <div class="agent-line agent-tone--@infoLine.Tone">@infoLine.Entry.Text</div>
    }
    else if (view is AgentCardView card && card.CardType == "done")
    {
        var parsed = AgentWidgetParser.Parse(card.Entry.Text);
        <div class="agent-card agent-card--done" data-testid="agent-result">
            <div class="agent-card__header">
                <div class="agent-card__title">@L["AGENT_RESULT"]</div>
                <button type="button" class="agent-copy @(_copiedEntry == card.Entry ? "agent-copy--copied" : "")"
                        @onclick="@(() => CopyEntry(card.Entry))"
                        title="@L[_copiedEntry == card.Entry ? "AGENT_COPIED" : "AGENT_COPY"]"
                        data-testid="agent-copy-btn">
                    @if (_copiedEntry == card.Entry)
                    {
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    }
                    else
                    {
                        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1.5" stroke="currentColor" stroke-width="1.4" /><path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.5" stroke="currentColor" stroke-width="1.4" /></svg>
                    }
                </button>
            </div>
            @if (parsed.Kpis.Count > 0)
            {
                <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:8px;">
                    @foreach (var kpi in parsed.Kpis)
                    {
                        <div class="agent-widget-kpi">
                            <div style="font-size:11px;color:var(--agent-muted);">@kpi.Title</div>
                            <div style="font-weight:600;">@kpi.Value</div>
                            @if (!string.IsNullOrWhiteSpace(kpi.Trend))
                            {
                                <div style="font-size:11px;color:var(--agent-done);">@kpi.Trend</div>
                            }
                        </div>
                    }
                </div>
            }
            @if (parsed.Charts.Count > 0)
            {
                <div style="display:flex;flex-direction:column;gap:8px;margin-bottom:8px;" data-testid="agent-widget-charts">
                    @foreach (var chart in parsed.Charts)
                    {
                        <div class="agent-widget-chart">
                            <div style="font-size:12px;font-weight:600;margin-bottom:6px;">@chart.Title</div>
                            @foreach (var bar in chart.Bars)
                            {
                                <div style="margin-bottom:6px;">
                                    <div style="display:flex;justify-content:space-between;font-size:11px;">
                                        <span>@bar.Label</span><span style="font-weight:600;">@bar.Value.ToString("0.##")</span>
                                    </div>
                                    <div class="agent-widget-chart__track">
                                        <div class="agent-widget-chart__fill" style="@($"width:{bar.PercentWidth.ToString("0.#", CultureInfo.InvariantCulture)}%;")"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(parsed.MarkdownText))
            {
                <div class="agent-md">@((MarkupString)SafeMarkdownFormatter.ToSafeHtml(parsed.MarkdownText))</div>
            }
            @if (parsed.Actions.Count > 0)
            {
                <div class="agent-panel__row agent-panel__row--options" style="margin-top:8px;">
                    @foreach (var act in parsed.Actions)
                    {
                        <button type="button" class="agent-button agent-button--option"
                                @onclick="@(() => Nav.NavigateTo(act.Route))">@act.Label</button>
                    }
                </div>
            }
        </div>
    }
    else if (view is AgentCardView askCard && askCard.CardType == "ask")
    {
        <div class="agent-card agent-card--ask agent-tone--ask">@askCard.Entry.Text</div>
    }
    else if (view is AgentCardView errorCard)
    {
        <div class="agent-card agent-card--error agent-tone--error" data-testid="agent-error">@L["AGENT_ERROR_PREFIX"]@errorCard.Entry.Text</div>
    }
    else if (view is AgentNotesView note)
    {
        <details class="agent-notes" data-testid="agent-help-note">
            <summary>@L["AGENT_HELP_NOTE_TITLE"]</summary>
            <div class="agent-pre-line" style="margin-top:4px;">@note.Entry.Text</div>
        </details>
    }
    else if (view is AgentStepGroupView group)
    {
        var open = _openStepGroups.Contains(group.Id);
        // Mutually exclusive with the floating AgentWorkingMark below (IsRunning && !WorkingGroup):
        // exactly ONE data-testid="agent-working" is ever in the DOM — the e2e runner's
        // getByTestId must stay strict-mode-safe.
        var isWorkingGroup = WorkingGroup && ReferenceEquals(group, Views[^1]);
        <div class="agent-steps">
            <div class="agent-steps__header"
                 role="@(isWorkingGroup ? "status" : null)"
                 aria-live="@(isWorkingGroup ? "polite" : null)">
                <button type="button" class="agent-steps__toggle @(open ? "agent-steps__toggle--open" : "")"
                        aria-expanded="@(open ? "true" : "false")"
                        title="@(open ? L["AGENT_STEPS_HIDE"] : L["AGENT_STEPS_SHOW"])"
                        @onclick="@(() => ToggleStepGroup(group.Id))">
                    <span class="agent-steps__arrow" aria-hidden="true"></span>
                    @if (isWorkingGroup)
                    {
                        @* Must be a real box (not display:contents): the e2e runner
                           polls agent-working visibility to detect the end of a run. *@
                        <span class="agent-working" data-testid="agent-working">
                            <AgentWorkingContent Mode="WorkMode" />
                        </span>
                    }
                    else
                    {
                        <span>@StepsSummary(group.StepCount)</span>
                    }
                    @if (group.HasWarning)
                    {
                        <span class="agent-steps__warn" title="@L["AGENT_STEPS_DID_NOT_WORK"]">(!)</span>
                    }
                </button>
            </div>
            @if (open)
            {
                <div class="agent-steps__body">
                    @foreach (var step in group.Steps)
                    {
                        <details class="agent-step">
                            <summary class="agent-step__summary agent-tone--@(step.Entry.IsBlocked ? "warn" : "tool")"
                                     title="@step.Entry.Text" data-testid="agent-step"
                                     data-blocked="@(step.Entry.IsBlocked ? "true" : null)">
                                @step.Title
                            </summary>
                            @* DecodeToolText is display-only: it never rewrites the raw entry text
                               that gets persisted or sent back to the model. Do not move it into
                               the persistence/transcript path. *@
                            <div class="agent-pre-line agent-tone--llm" style="padding-inline-start:8px;">@AgentLogViewBuilder.DecodeToolText(step.Entry.Text)</div>
                        </details>
                    }
                </div>
            }
        </div>
    }
}

@if (IsRunning && !WorkingGroup)
{
    <AgentWorkingMark IsActive="true" Mode="WorkMode" TestId="agent-working" />
}

@code {
    [Parameter] public IReadOnlyList<AgentLogView> Views { get; set; } = [];
    [Parameter] public bool WorkingGroup { get; set; }
    [Parameter] public AgentWorkingMode WorkMode { get; set; } = AgentWorkingMode.Think;
    [Parameter] public bool IsRunning { get; set; }

    private readonly HashSet<string> _openStepGroups = [];
    private AgentClientService.AgentChatEntry? _copiedEntry;
    private bool _disposed;
    private const int CopiedEntryFeedbackMs = 1500;

    /// <summary>Forgets expanded step groups and copy feedback; call on chat switch/logout.</summary>
    public void ResetOpenGroups()
    {
        _openStepGroups.Clear();
        _copiedEntry = null;
    }

    private void ToggleStepGroup(string id)
    {
        if (!_openStepGroups.Remove(id)) _openStepGroups.Add(id);
    }

    private string StepsSummary(int count)
    {
        var key = count == 1 ? "AGENT_STEPS_ONE" : "AGENT_STEPS_MANY";
        try { return string.Format(L[key], count); } catch (FormatException) { return count.ToString(); }
    }

    private async Task CopyEntry(AgentClientService.AgentChatEntry entry)
    {
        try
        {
            var ok = await JS.InvokeAsync<bool>("crmAgentDriver.copyText", entry.Text);
            if (!ok || _disposed) return;
            _copiedEntry = entry;
            StateHasChanged();
            await Task.Delay(CopiedEntryFeedbackMs);
            if (!_disposed && _copiedEntry == entry) { _copiedEntry = null; StateHasChanged(); }
        }
        catch (JSException) { /* clipboard unavailable */ }
    }

    public void Dispose() => _disposed = true;
}
