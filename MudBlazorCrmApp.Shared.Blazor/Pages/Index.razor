@page "/"
@inject NavigationManager NavigationManager
@inject AppText L

<AuthorizeView>
    <Authorized>
        @* Redirect to CRM Dashboard when authorized *@
    </Authorized>
    <NotAuthorized>
        <div class="mb-3">
            <MudText Typo="Typo.h3">@L["HOME_WELCOME"]</MudText>
        </div>
        <MudText>@L["HOME_SUBTITLE"]</MudText>
        <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-16">
            <MudPaper Class="pa-8 mud-elevation-4">
                <MudGrid Spacing="4">
                    <MudItem xs="12">
                        <MudPaper Class="pa-8 mud-elevation-2 rounded-lg" Style="background-color: var(--mud-palette-surface-lighten)">
                            <MudGrid Spacing="4">
                                <MudItem xs="12" md="8">
                                    <MudText Typo="Typo.h4" GutterBottom>@L["HOME_HERO_TITLE"]</MudText>
                                    <MudText Typo="Typo.body1" Class="mb-4">@L["HOME_HERO_DESC"]</MudText>
                                    <MudButton Href="/login" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">@L["UI_SIGN_IN"]</MudButton>
                                    <MudButton Href="/register" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Large" Class="ml-4">@L["NAV_REGISTER"]</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12">
                        <MudText Typo="Typo.h5" Class="mb-4">@L["HOME_KEY_FEATURES"]</MudText>
                        <MudGrid Spacing="4">
                            <MudItem xs="12" md="4">
                                <MudCard Class="mud-elevation-2 rounded-lg" Style="height: 100%;">
                                    <MudCardContent Class="pa-6 text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                                        <MudText Typo="Typo.subtitle1" GutterBottom>@L["HOME_FEAT_CUSTOMERS_TITLE"]</MudText>
                                        <MudText Typo="Typo.body2">@L["HOME_FEAT_CUSTOMERS_DESC"]</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudCard Class="mud-elevation-2 rounded-lg" Style="height: 100%;">
                                    <MudCardContent Class="pa-6 text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Large" Color="Color.Success" Class="mb-3" />
                                        <MudText Typo="Typo.subtitle1" GutterBottom>@L["RPT_SALES_PIPELINE"]</MudText>
                                        <MudText Typo="Typo.body2">@L["HOME_FEAT_PIPELINE_DESC"]</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudCard Class="mud-elevation-2 rounded-lg" Style="height: 100%;">
                                    <MudCardContent Class="pa-6 text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Size="Size.Large" Color="Color.Warning" Class="mb-3" />
                                        <MudText Typo="Typo.subtitle1" GutterBottom>@L["ENT_SUPPORT_CASES"]</MudText>
                                        <MudText Typo="Typo.body2">@L["HOME_FEAT_SUPPORT_DESC"]</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12">
                        <MudGrid Spacing="4">
                            <MudItem xs="12" md="4">
                                <MudCard Class="mud-elevation-2 rounded-lg" Style="height: 100%;">
                                    <MudCardContent Class="pa-6 text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" Color="Color.Info" Class="mb-3" />
                                        <MudText Typo="Typo.subtitle1" GutterBottom>@L["HOME_FEAT_DASHBOARD_TITLE"]</MudText>
                                        <MudText Typo="Typo.body2">@L["HOME_FEAT_DASHBOARD_DESC"]</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudCard Class="mud-elevation-2 rounded-lg" Style="height: 100%;">
                                    <MudCardContent Class="pa-6 text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.ViewKanban" Size="Size.Large" Color="Color.Secondary" Class="mb-3" />
                                        <MudText Typo="Typo.subtitle1" GutterBottom>@L["NAV_KANBAN_BOARD"]</MudText>
                                        <MudText Typo="Typo.body2">@L["HOME_FEAT_KANBAN_DESC"]</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudCard Class="mud-elevation-2 rounded-lg" Style="height: 100%;">
                                    <MudCardContent Class="pa-6 text-center">
                                        <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Large" Color="Color.Tertiary" Class="mb-3" />
                                        <MudText Typo="Typo.subtitle1" GutterBottom>@L["NAV_PRODUCTS_GROUP"]</MudText>
                                        <MudText Typo="Typo.body2">@L["HOME_FEAT_PRODUCTS_DESC"]</MudText>
                                    </MudCardContent>
                                </MudCard>
                            </MudItem>
                        </MudGrid>
                    </MudItem>
                    <MudItem xs="12" Class="text-center mt-8">
                        <MudText Typo="Typo.h6" Color="Color.Dark">@L["HOME_READY"]</MudText>
                        <MudButton Href="/register" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" Class="mt-4">@L["UI_CREATE_ACCOUNT"]</MudButton>
                    </MudItem>
                </MudGrid>
            </MudPaper>
            <MudText Align="Align.Center" Class="mt-8">� 2026 MudBlazor CRM</MudText>
        </MudContainer>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;
            if (authState.User.Identity?.IsAuthenticated == true)
            {
                NavigationManager.NavigateTo("/crmdashboard", replace: true);
            }
        }
    }
}
