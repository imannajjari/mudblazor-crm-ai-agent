@page "/import"
@inject AppService AppService
@inject ISnackbar Snackbar
@attribute [Authorize]
@inject AppText L

<PageTitle>@L["NAV_IMPORT_DATA"]</PageTitle>

<div class="mb-3">
    <MudText Typo="Typo.h3">@L["NAV_IMPORT_DATA"]</MudText>
</div>

<MudPaper Class="pa-6" Elevation="3">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudSelect T="string" @bind-Value="selectedEntity" Label="@L["FLD_ENTITY_TYPE"]" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@("contacts")">@L["ENT_CONTACTS"]</MudSelectItem>
                <MudSelectItem Value="@("customers")">@L["ENT_CUSTOMERS"]</MudSelectItem>
                <MudSelectItem Value="@("leads")">@L["ENT_LEADS"]</MudSelectItem>
                <MudSelectItem Value="@("opportunities")">@L["ENT_OPPORTUNITIES"]</MudSelectItem>
                <MudSelectItem Value="@("sales")">@L["ENT_SALES"]</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".csv">
                <ActivatorContent>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">@L["UI_SELECT_CSV"]</MudButton>
                </ActivatorContent>
            </MudFileUpload>
            @if (selectedFile != null)
            {
                <MudText Typo="Typo.body2" Class="mt-2">@L["IMP_SELECTED"]: @selectedFile.Name (@(selectedFile.Size / 1024) KB)</MudText>
            }
        </MudItem>
        <MudItem xs="12">
            <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="DoImport" Disabled="@(selectedFile == null || string.IsNullOrEmpty(selectedEntity) || isImporting)" StartIcon="@Icons.Material.Filled.Upload">
                @if (isImporting)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>@L["IMP_IMPORTING"]</span>
                }
                else
                {
                    <span>@L["IMP_IMPORT_BTN"]</span>
                }
            </MudButton>
        </MudItem>
    </MudGrid>

    @if (importResult != null)
    {
        <MudAlert Severity="Severity.Success" Class="mt-4">
            @string.Format(L["IMP_SUCCESS"], importResult.Imported, importResult.Total)
        </MudAlert>
    }

    <MudDivider Class="my-4" />
    <MudText Typo="Typo.h6">@L["IMP_CSV_GUIDE"]</MudText>
    <MudText Typo="Typo.body2" Class="mt-2">
        <b>@L["ENT_CONTACTS"]:</b> Name, Email, Phone, Role, Notes
    </MudText>
    <MudText Typo="Typo.body2">
        <b>@L["ENT_CUSTOMERS"]:</b> Name, Type, Industry, Notes
    </MudText>
    <MudText Typo="Typo.body2">
        <b>@L["ENT_LEADS"]:</b> Source, Status, PotentialValue, Notes
    </MudText>
    <MudText Typo="Typo.body2">
        <b>@L["ENT_OPPORTUNITIES"]:</b> Name, Stage, Value, Probability, Source, Notes
    </MudText>
    <MudText Typo="Typo.body2">
        <b>@L["ENT_SALES"]:</b> Quantity, UnitPrice, TotalAmount, SaleDate, Notes
    </MudText>
</MudPaper>

@code {
    private string? selectedEntity;
    private IBrowserFile? selectedFile;
    private bool isImporting;
    private ImportResult? importResult;

    private void OnFileSelected(IBrowserFile file)
    {
        selectedFile = file;
        importResult = null;
    }

    private async Task DoImport()
    {
        if (selectedFile == null || string.IsNullOrEmpty(selectedEntity)) return;

        isImporting = true;
        importResult = null;
        StateHasChanged();

        try
        {
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            importResult = await AppService.ImportCsvAsync(selectedEntity, stream, selectedFile.Name);
            Snackbar.Add($"Imported {importResult?.Imported} records successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            isImporting = false;
            StateHasChanged();
        }
    }
}
