@inject AppService AppService
@inject ISnackbar Snackbar
@inject AppText L

<EditForm Model="@record" OnValidSubmit="@OnSubmit">
    <DataAnnotationsValidator />
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">@L["ADD_EMAIL_TEMPLATE"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="record.Name" For="@(() => record.Name)" Label="@L["FLD_TEMPLATE_NAME"]" Required="true" />
            <MudSelect @bind-Value="record.Category" Label="@L["FLD_CATEGORY"]" For="@(() => record.Category)">
                <MudSelectItem Value="@("Onboarding")">Onboarding</MudSelectItem>
                <MudSelectItem Value="@("Sales")">Sales</MudSelectItem>
                <MudSelectItem Value="@("Support")">Support</MudSelectItem>
                <MudSelectItem Value="@("Communication")">Communication</MudSelectItem>
                <MudSelectItem Value="@("Account Management")">Account Management</MudSelectItem>
                <MudSelectItem Value="@("Marketing")">Marketing</MudSelectItem>
                <MudSelectItem Value="@("Billing")">Billing</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="record.Description" For="@(() => record.Description)" Label="@L["FLD_DESCRIPTION"]" />
            <MudTextField @bind-Value="record.Subject" For="@(() => record.Subject)" Label="@L["FLD_SUBJECT_LINE"]" Required="true" />
            <MudTextField @bind-Value="record.Body" For="@(() => record.Body)" Label="@L["FLD_BODY_TEXT"]" Lines="10" />
            <MudTextField @bind-Value="record.HtmlBody" For="@(() => record.HtmlBody)" Label="@L["FLD_BODY_HTML"]" Lines="10" HelperText="Optional HTML version" />
            <MudCheckBox @bind-Value="record.IsActive" Label="@L["FLD_ACTIVE"]" />
            <MudText Typo="Typo.caption" Class="mt-2">
                Available placeholders: @("{{ContactName}}, {{CustomerName}}, {{CompanyName}}, {{SenderName}}, {{OpportunityName}}, {{Value}}, {{CaseId}}, {{CaseSubject}}")
            </MudText>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="OnCancel">@L["ACTION_CANCEL"]</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">@L["ACTION_ADD"]</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    private EmailTemplate record = new() { IsActive = true };

    private void OnCancel()
    {
        MudDialog?.Cancel();
    }

    private async Task OnSubmit()
    {
        try
        {
            await AppService.InsertEmailTemplateAsync(record);
            MudDialog?.Close();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
