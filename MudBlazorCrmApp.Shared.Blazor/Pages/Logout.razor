@page "/logout"
@using MudBlazorCrmApp.Shared.Blazor.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject AgentClientService Agent

<PageTitle>Logout</PageTitle>

<div class="mb-3">
    <MudText Typo="Typo.h3">Logout</MudText>
</div>

<MudText>Logging out...</MudText>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Agent.ClearOnLogoutAsync();
        await ((IdentityAuthenticationStateProvider)AuthenticationStateProvider).LogoutAsync();

        Navigation.NavigateTo("");
    }
}
