@page "/logout"
@using MudBlazorCrmApp.Shared.Blazor.Services
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject NavigationManager Navigation
@inject AgentClientService Agent
@inject AppText L

<PageTitle>@L["NAV_LOGOUT"]</PageTitle>

<div class="mb-3">
    <MudText Typo="Typo.h3">@L["NAV_LOGOUT"]</MudText>
</div>

<MudText>@L["UI_LOGGING_OUT"]</MudText>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Agent.ClearOnLogoutAsync();
        await ((IdentityAuthenticationStateProvider)AuthenticationStateProvider).LogoutAsync();

        Navigation.NavigateTo("");
    }
}
