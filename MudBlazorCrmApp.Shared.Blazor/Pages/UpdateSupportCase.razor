@inject AppService AppService
@inject ISnackbar Snackbar
@inject HttpClient HttpClient
@inject AppText L

@if (record == null)
{
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">@L["UPD_SUPPORT_CASE"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudText>@L["UI_LOADING"]</MudText>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="OnCancel">@L["ACTION_CANCEL"]</MudButton>
            <MudButton Color="Color.Primary" Disabled="true">@L["UI_UPDATE"]</MudButton>
        </DialogActions>
    </MudDialog>
}
else
{
    <EditForm Model="@record" OnValidSubmit="@OnSubmit">
        <DataAnnotationsValidator />
        <MudDialog>
            <TitleContent>
                <MudText Typo="Typo.h6">@L["UPD_SUPPORT_CASE"]</MudText>
            </TitleContent>
            <DialogContent>
                <MudNumericField @bind-Value="record.Id" For="@(() => record.Id)" Label="@L["FLD_ID"]" ReadOnly="true" />
                <MudTextField @bind-Value="record.Title" For="@(() => record.Title)" Label="@L["FLD_TITLE"]" />
                <MudNumericField @bind-Value="record.CustomerId" For="@(() => record.CustomerId)" Label="@L["FLD_CUSTOMER_ID"]" />
                <MudNumericField @bind-Value="record.ContactId" For="@(() => record.ContactId)" Label="@L["FLD_CONTACT_ID"]" />
                <MudNumericField @bind-Value="record.ProductId" For="@(() => record.ProductId)" Label="@L["FLD_PRODUCT_ID"]" />
                <MudNumericField @bind-Value="record.ServiceId" For="@(() => record.ServiceId)" Label="@L["FLD_SERVICE_ID"]" />
                <MudSelect @bind-Value="record.Priority" Label="@L["FLD_PRIORITY"]" For="@(() => record.Priority)">
                    <MudSelectItem Value="@("Low")">Low</MudSelectItem>
                    <MudSelectItem Value="@("Medium")">Medium</MudSelectItem>
                    <MudSelectItem Value="@("High")">High</MudSelectItem>
                    <MudSelectItem Value="@("Critical")">Critical</MudSelectItem>
                </MudSelect>
                <MudSelect @bind-Value="record.Status" Label="@L["FLD_STATUS"]" For="@(() => record.Status)">
                    <MudSelectItem Value="@("New")">New</MudSelectItem>
                    <MudSelectItem Value="@("Open")">Open</MudSelectItem>
                    <MudSelectItem Value="@("In Progress")">In Progress</MudSelectItem>
                    <MudSelectItem Value="@("Waiting on Customer")">Waiting on Customer</MudSelectItem>
                    <MudSelectItem Value="@("Resolved")">Resolved</MudSelectItem>
                    <MudSelectItem Value="@("Closed")">Closed</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="record.Category" For="@(() => record.Category)" Label="@L["FLD_CATEGORY"]" />
                <MudSelect @bind-Value="record.Channel" Label="@L["FLD_CHANNEL"]" For="@(() => record.Channel)">
                    <MudSelectItem Value="@("Email")">Email</MudSelectItem>
                    <MudSelectItem Value="@("Phone")">Phone</MudSelectItem>
                    <MudSelectItem Value="@("Chat")">Chat</MudSelectItem>
                    <MudSelectItem Value="@("Portal")">Portal</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="record.Description" For="@(() => record.Description)" Label="@L["FLD_DESCRIPTION"]" Lines="3" />
                <MudTextField @bind-Value="record.Resolution" For="@(() => record.Resolution)" Label="@L["FLD_RESOLUTION"]" Lines="3" />
                <MudTextField @bind-Value="record.AssignedUserId" For="@(() => record.AssignedUserId)" Label="@L["FLD_ASSIGNED_USER_ID"]" />
                <MudNumericField @bind-Value="record.SlaHours" For="@(() => record.SlaHours)" Label="@L["FLD_SLA_HOURS"]" />
                <MudTextField Format="s" InputType="InputType.DateTimeLocal" @bind-Value="record.DueDate" For="@(() => record.DueDate)" Label="@L["FLD_DUE_DATE"]" />
                <MudTextField Format="s" InputType="InputType.DateTimeLocal" @bind-Value="record.FollowupDate" For="@(() => record.FollowupDate)" Label="@L["FLD_FOLLOWUP_DATE"]" />
                <MudTextField Format="s" InputType="InputType.DateTimeLocal" @bind-Value="record.ResolvedDate" For="@(() => record.ResolvedDate)" Label="@L["FLD_RESOLVED_DATE"]" />
                <MudFileUpload T="IBrowserFile" FilesChanged="@(async args => record.Icon = await UploadImageAsync(args, 256, 256))" Accept=".png,.jpg,.jpeg">
                    <CustomContent Context="fileUpload">
                        <MudIconButton OnClick="@fileUpload.OpenFilePickerAsync" Color="Color.Info"
                                       Icon="@Icons.Material.Filled.PhotoCamera">
                        </MudIconButton>
                    </CustomContent>
                </MudFileUpload>
                @if (!string.IsNullOrEmpty(record.Icon))
                {
                    <MudImage Src="@GetAbsoluteUri(record.Icon)" Style="width:128px;height:128px;object-fit:contain;" Class="mt-1" />
                }
                <MudTextField @bind-Value="record.Notes" For="@(() => record.Notes)" Label="@L["FLD_NOTES"]" Lines="3" />

                <TagSelector EntityType="SupportCase" EntityId="@(record.Id ?? 0)" />
                <EntityAttachments EntityType="SupportCase" EntityId="@(record.Id ?? 0)" />
                <EntityTimeline EntityType="SupportCase" EntityId="@(record.Id ?? 0)" />
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="OnCancel">@L["ACTION_CANCEL"]</MudButton>
                <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">@L["UI_UPDATE"]</MudButton>
            </DialogActions>
        </MudDialog>
    </EditForm>
}

@code {
    [Parameter]
    public long Id { get; set; }

    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    private SupportCase? record;

    private string GetAbsoluteUri(string uri)
    {
        if (!uri.StartsWith("/"))
        {
            return uri;
        }

        var baseUri = HttpClient.BaseAddress;

        if (baseUri == null)
        {
            throw new Exception("Unable to determine base address");
        }

        Uri absolute = new(baseUri, uri);

        return absolute.ToString();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            record = await AppService.GetSupportCaseByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OnCancel()
    {
        MudDialog?.Cancel();
    }

    private async void OnSubmit()
    {
        if (record == null)
        {
            return;
        }

        try
        {
            await AppService.UpdateSupportCaseAsync(Id, record);
            MudDialog?.Close();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task<string?> UploadImageAsync(IBrowserFile file, int maxWidth = 256, int maxHeight = 256)
    {
        if (file.ContentType != "image/png" && file.ContentType != "image/jpeg")
        {
            Snackbar.Add("Only PNG or JPEG images can be uploaded.", Severity.Error);
            return null;
        }

        var image = await file.RequestImageFileAsync("image/png", maxWidth, maxHeight);

        try
        {
            return await AppService.UploadImageAsync(image);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        return null;
    }
}
