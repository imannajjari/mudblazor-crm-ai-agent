@inject AppService AppService
@inject ISnackbar Snackbar
@inject AppText L

<EditForm Model="@record" OnValidSubmit="@OnSubmit">
    <DataAnnotationsValidator />
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">@L["UI_LOG_COMM"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudSelect @bind-Value="record.Type" Label="@L["FLD_TYPE"]" For="@(() => record.Type)">
                <MudSelectItem Value="@("Email")">Email</MudSelectItem>
                <MudSelectItem Value="@("Call")">Call</MudSelectItem>
                <MudSelectItem Value="@("Meeting")">Meeting</MudSelectItem>
                <MudSelectItem Value="@("Note")">Note</MudSelectItem>
                <MudSelectItem Value="@("SMS")">SMS</MudSelectItem>
                <MudSelectItem Value="@("VideoCall")">Video Call</MudSelectItem>
                <MudSelectItem Value="@("InPerson")">In Person</MudSelectItem>
                <MudSelectItem Value="@("SocialMedia")">Social Media</MudSelectItem>
            </MudSelect>
            <MudSelect @bind-Value="record.Direction" Label="@L["FLD_DIRECTION"]" For="@(() => record.Direction)">
                <MudSelectItem Value="@("Outbound")">Outbound</MudSelectItem>
                <MudSelectItem Value="@("Inbound")">Inbound</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="record.Subject" For="@(() => record.Subject)" Label="@L["FLD_SUBJECT"]" />
            <MudTextField @bind-Value="record.Body" For="@(() => record.Body)" Label="@L["FLD_BODY"]" Lines="4" />
            <MudSelect @bind-Value="record.Status" Label="@L["FLD_STATUS"]" For="@(() => record.Status)">
                <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
                <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                <MudSelectItem Value="@("Scheduled")">Scheduled</MudSelectItem>
                <MudSelectItem Value="@("Cancelled")">Cancelled</MudSelectItem>
            </MudSelect>
            <MudNumericField @bind-Value="record.ContactId" For="@(() => record.ContactId)" Label="@L["FLD_CONTACT_ID"]" />
            <MudNumericField @bind-Value="record.CustomerId" For="@(() => record.CustomerId)" Label="@L["FLD_CUSTOMER_ID"]" />
            <MudNumericField @bind-Value="record.LeadId" For="@(() => record.LeadId)" Label="@L["FLD_LEAD_ID"]" />
            <MudNumericField @bind-Value="record.OpportunityId" For="@(() => record.OpportunityId)" Label="@L["FLD_OPPORTUNITY_ID"]" />
            <MudNumericField @bind-Value="record.SupportCaseId" For="@(() => record.SupportCaseId)" Label="@L["FLD_SUPPORT_CASE_ID"]" />
            <MudTextField Format="s" InputType="InputType.DateTimeLocal" @bind-Value="record.CommunicationDate" For="@(() => record.CommunicationDate)" Label="@L["FLD_DATE"]" />
            <MudNumericField @bind-Value="record.DurationMinutes" For="@(() => record.DurationMinutes)" Label="@L["FLD_DURATION_MIN"]" />
            <MudTextField @bind-Value="record.Outcome" For="@(() => record.Outcome)" Label="@L["FLD_OUTCOME"]" />
            <MudCheckBox @bind-Value="record.FollowUpRequired" For="@(() => record.FollowUpRequired)" Label="@L["FLD_FOLLOWUP_REQ"]" />
            @if (record.FollowUpRequired)
            {
                <MudTextField Format="s" InputType="InputType.DateTimeLocal" @bind-Value="record.FollowUpDate" For="@(() => record.FollowUpDate)" Label="@L["FLD_FOLLOWUP_DATE"]" />
            }
            <MudTextField @bind-Value="record.Notes" For="@(() => record.Notes)" Label="@L["FLD_NOTES"]" Lines="3" />
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="OnCancel">@L["ACTION_CANCEL"]</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">@L["ACTION_ADD"]</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    private Communication record = new()
    {
        CommunicationDate = DateTime.Now,
        Status = "Completed",
        Direction = "Outbound"
    };

    private void OnCancel()
    {
        MudDialog?.Cancel();
    }

    private async void OnSubmit()
    {
        try
        {
            await AppService.InsertCommunicationAsync(record);
            MudDialog?.Close();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
