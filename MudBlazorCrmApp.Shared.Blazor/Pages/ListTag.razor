@page "/tag"
@inject AppService AppService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@attribute [Authorize]
@inject AppText L

<PageTitle>@L["ENT_TAGS"]</PageTitle>

<div class="mb-3">
    <MudText Typo="Typo.h3">@L["ENT_TAGS"]</MudText>
</div>

<MudStack AlignItems="AlignItems.End" Class="mb-3">
    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" OnClick="@(e => OnAdd())">@L["ACTION_ADD"]</MudButton>
</MudStack>

<MudDataGrid T="Tag" @ref="grid" ServerData="@ServerReload" Filterable="true">
    <ToolBarContent>
         <MudText Typo="Typo.h6">@L["ENT_TAGS"]</MudText>
         <MudSpacer />
         <MudTextField T="string" Placeholder="@L["ACTION_SEARCH"]" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" ValueChanged="@(value => SearchChanged(value))"></MudTextField>
    </ToolBarContent>
    <Columns>
        <PropertyColumn Property="x => x!.Id" Title="@L["FLD_ID"]" />
        <PropertyColumn Property="x => x!.Name" Title="@L["FLD_NAME"]" />
        <TemplateColumn Title="@L["FLD_COLOR"]" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudChip T="string" Style="@($"background-color:{context.Item!.Color ?? "#594AE2"};color:white")">@context.Item!.Color</MudChip>
            </CellTemplate>
        </TemplateColumn>
        <TemplateColumn Style="width: 50px;" StickyRight="true" Sortable="false" Filterable="false">
            <CellTemplate>
                <MudStack Row="true">
                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="@Size.Small" title="@L["ACTION_EDIT"]" OnClick="@(e => OnEdit(context.Item!))" />
                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="@Size.Small" title="@L["ACTION_DELETE"]" OnClick="@(e => OnDelete(context.Item!))" />
                </MudStack>
            </CellTemplate>
        </TemplateColumn>
    </Columns>
    <PagerContent>
        <MudDataGridPager T="Tag" />
    </PagerContent>
</MudDataGrid>

@code {
    private MudDataGrid<Tag>? grid;
    private string? _searchString;

    private async Task<GridData<Tag>> ServerReload(GridState<Tag> state, CancellationToken cancellationToken)
    {
        var top = state.PageSize;
        var skip = state.Page * state.PageSize;
        var orderby = ODataHelpers.GetOrderBy(state.SortDefinitions);
        var filter = ODataHelpers.GetFilter(state.FilterDefinitions);

        AppService.ODataResult<Tag>? result = null;
        try
        {
            if (_searchString?.Length > 0)
            {
                filter = $"contains(tolower(Name), '{_searchString}')";
            }
            result = await AppService.ListTagODataAsync(top, skip, orderby, filter, true, null);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        return new() { TotalItems = result?.Count ?? 0, Items = result?.Value ?? Enumerable.Empty<Tag>() };
    }

    private async void OnAdd()
    {
        DialogOptions dialogOptions = new() { FullWidth = true, CloseOnEscapeKey = true };
        var dialogRef = await DialogService.ShowAsync<AddTag>(L["ADD_TAG"], dialogOptions);
        var result = await dialogRef.Result;
        if (result is { Canceled: false }) await (grid?.ReloadServerData() ?? Task.CompletedTask);
    }

    private async void OnEdit(Tag record)
    {
        DialogParameters<UpdateTag> dialogParams = new() { { x => x.Id, record.Id!.Value } };
        DialogOptions dialogOptions = new() { FullWidth = true, CloseOnEscapeKey = true };
        var dialogRef = await DialogService.ShowAsync<UpdateTag>(L["UPD_TAG"], dialogParams, dialogOptions);
        var result = await dialogRef.Result;
        if (result is { Canceled: false }) await (grid?.ReloadServerData() ?? Task.CompletedTask);
    }

    private async void OnDelete(Tag record)
    {
        var result = await DialogService.ShowMessageBoxAsync(L["UI_WARNING"], "Are you sure you want to delete this tag?", L["ACTION_DELETE"], L["ACTION_CANCEL"]);
        if (result.GetValueOrDefault(false))
        {
            try
            {
                await AppService.DeleteTagAsync(record.Id!.Value);
                await (grid?.ReloadServerData() ?? Task.CompletedTask);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private void SearchChanged(string Value)
    {
        if (Value.EndsWith(".")) return;
        _searchString = Value.ToString().ToLower();
        grid?.ReloadServerData();
    }
}
