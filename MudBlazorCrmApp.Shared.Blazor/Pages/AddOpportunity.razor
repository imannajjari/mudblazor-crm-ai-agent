@inject AppService AppService
@inject ISnackbar Snackbar
@inject HttpClient HttpClient
@inject AppText L

<EditForm Model="@record" OnValidSubmit="@OnSubmit">
    <DataAnnotationsValidator />
    <MudDialog>
        <TitleContent>
            <MudText Typo="Typo.h6">@L["ADD_OPPORTUNITY"]</MudText>
        </TitleContent>
        <DialogContent>
            <MudTextField @bind-Value="record.Name" For="@(() => record.Name)" Label="@L["FLD_NAME"]" />
            <MudNumericField @bind-Value="record.Value" For="@(() => record.Value)" Label="@L["FLD_VALUE_USD"]" />
            <MudNumericField @bind-Value="record.Probability" For="@(() => record.Probability)" Label="@L["FLD_PROBABILITY"]" Min="0" Max="100" />
            <MudTextField Format="s" InputType="InputType.DateTimeLocal" @bind-Value="record.EstimatedCloseDate" For="@(() => record.EstimatedCloseDate)" Label="@L["FLD_EST_CLOSE_DATE"]" />
            <MudSelect @bind-Value="record.Stage" Label="@L["FLD_STAGE"]" AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem Value="@("Prospecting")">Prospecting</MudSelectItem>
                <MudSelectItem Value="@("Qualification")">Qualification</MudSelectItem>
                <MudSelectItem Value="@("Proposal")">Proposal</MudSelectItem>
                <MudSelectItem Value="@("Negotiation")">Negotiation</MudSelectItem>
                <MudSelectItem Value="@("Closed Won")">Closed Won</MudSelectItem>
                <MudSelectItem Value="@("Closed Lost")">Closed Lost</MudSelectItem>
            </MudSelect>
            <MudSelect T="long?" @bind-Value="record.CustomerId" Label="@L["ENT_CUSTOMER"]" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                @if (customers != null)
                {
                    @foreach (var customer in customers)
                    {
                        <MudSelectItem T="long?" Value="@customer.Id">@customer.Name</MudSelectItem>
                    }
                }
            </MudSelect>
            <MudSelect T="long?" @bind-Value="record.ContactId" Label="@L["ENT_CONTACT"]" AnchorOrigin="Origin.BottomCenter" Clearable="true">
                @if (contacts != null)
                {
                    @foreach (var contact in contacts)
                    {
                        <MudSelectItem T="long?" Value="@contact.Id">@contact.Name</MudSelectItem>
                    }
                }
            </MudSelect>
            <MudFileUpload T="IBrowserFile" FilesChanged="@(async args => record.Icon = await UploadImageAsync(args, 256, 256))" Accept=".png,.jpg,.jpeg">
                <CustomContent Context="fileUpload">
                    <MudIconButton OnClick="@fileUpload.OpenFilePickerAsync" Color="Color.Info"
                                   Icon="@Icons.Material.Filled.PhotoCamera">
                    </MudIconButton>
                </CustomContent>
            </MudFileUpload>
            @if (!string.IsNullOrEmpty(record.Icon))
            {
                <MudImage Src="@GetAbsoluteUri(record.Icon)" Style="width:128px;height:128px;object-fit:contain;" Class="mt-1" />
            }
            <MudTextField @bind-Value="record.Notes" For="@(() => record.Notes)" Label="@L["FLD_NOTES"]" />

        </DialogContent>
        <DialogActions>
            <MudButton OnClick="OnCancel">@L["ACTION_CANCEL"]</MudButton>
            <MudButton ButtonType="ButtonType.Submit" Color="Color.Primary">@L["ACTION_ADD"]</MudButton>
        </DialogActions>
    </MudDialog>
</EditForm>

@code {
    [CascadingParameter]
    IMudDialogInstance? MudDialog { get; set; }

    private Opportunity record = new() { Stage = "Prospecting" };
    private Customer[]? customers;
    private Contact[]? contacts;

    private string GetAbsoluteUri(string uri)
    {
        if (!uri.StartsWith("/"))
        {
            return uri;
        }

        var baseUri = HttpClient.BaseAddress;

        if (baseUri == null)
        {
            throw new Exception("Unable to determine base address");
        }

        Uri absolute = new(baseUri, uri);

        return absolute.ToString();
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        try
        {
            customers = await AppService.ListCustomerAsync();
            contacts = await AppService.ListContactAsync();
        }
        catch(Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private void OnCancel()
    {
        MudDialog?.Cancel();
    }

    private async Task OnSubmit()
    {
        try
        {
            await AppService.InsertOpportunityAsync(record);
            MudDialog?.Close();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task<string?> UploadImageAsync(IBrowserFile file, int maxWidth = 256, int maxHeight = 256)
    {
        if (file.ContentType != "image/png" && file.ContentType != "image/jpeg")
        {
            Snackbar.Add("Only PNG or JPEG images can be uploaded.", Severity.Error);
            return null;
        }

        var image = await file.RequestImageFileAsync("image/png", maxWidth, maxHeight);

        try
        {
            return await AppService.UploadImageAsync(image);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }

        return null;
    }
}
